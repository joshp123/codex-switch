PUBLISHED_RELEASE_LINE = re.compile(r'\d{4}/\d\d/\d\d \d\d:\d\d:\d\d ')


def no_credential_reaches_the_proxy_output(system):
    """No proxy log or launchd output holds any part of a credential in the run's logins"""
    credentials = {**system.credentials, **rig.held_credentials()}
    files, found = rig.proxy_output_files(), []
    for path in files:
        # The published releases a group updates from predate this check, and wrote their lines with times such as
        # 2026/11/09 18:45:42; this tree's builds write RFC 3339 times.
        text = '\n'.join(line for line in path.read_text(errors='replace').splitlines() if not PUBLISHED_RELEASE_LINE.match(line))
        found += [f'{path.relative_to(rig.RUN)} holds part of {credentials[credential]}: {line[:400]}'
                  for line, credential in rig.credential_pieces(text, credentials)]
    if found:
        raise Failure('\n'.join(found[:10]) + (f'\n...and {len(found) - 10} more lines' if len(found) > 10 else ''))
    return f'{len(files)} proxy logs and launchd output files hold no part of the {len(credentials)} credentials in this run\'s logins.'



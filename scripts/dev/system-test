SPENDING_PAUSED = 'so spending reset credits is paused'


def a_signed_out_account_pauses_resets_and_says_why_once(system):
    """While the account a credit reset is signed out, so OpenAI's usage reading cannot show the reset, no credit is
    spent, and the log says once that spending is paused and why. Work resumes on that account once it signs in again"""
    system.extra = ['usage-lag']
    system.apply()
    rig.wait_for(lambda: spends() and READING_LAGS in rig.proxy_log(), 'the proxy to spend a credit, then wait for OpenAI\'s reading to show it')
    account = CHOSEN_CREDIT['cli'][0]
    path = rig.RUN / 'data' / account / 'auth.json'
    signed_in = path.read_text()
    auth = json.loads(signed_in)
    auth['tokens']['access_token'] = ''
    path.with_name('auth.json.next').write_text(json.dumps(auth))
    os.replace(path.with_name('auth.json.next'), path)
    paused = lambda: [line for line in rig.proxy_log().splitlines() if SPENDING_PAUSED in line]
    rig.wait_for(paused, f'the proxy to log that spending is paused while {account} is signed out')
    # Each reset decision reads every signed-in account afresh.
    reads = len(rig.fake_provider_events('usage-read', account='account-1'))
    rig.wait_for(lambda: len(rig.fake_provider_events('usage-read', account='account-1')) >= reads + 5, 'more reset decisions')
    said = paused()
    if len(said) != 1 or spends() != [CHOSEN_CREDIT['cli']]:
        raise Failure(f'Expected one spend, of {CHOSEN_CREDIT["cli"][1]}, and one line saying spending is paused; OpenAI spent {spends()} '
                      f'and the proxy logged:\n' + '\n'.join(said))
    path.with_name('auth.json.next').write_text(signed_in)
    os.replace(path.with_name('auth.json.next'), path)
    system.extra = []
    system.apply()
    resumed_on_the_reset_account(system.waiting)
    system.record_codex_task('work waiting for a reset', system.waiting.thread)
    return (f'The proxy spent {CHOSEN_CREDIT["cli"][1]}; then {account} was signed out while OpenAI\'s reading still lagged. '
            f'Over the next reset decisions it spent nothing and logged once:\n{said[0].split(" ", 1)[1]}\n'
            f'Once {account} was signed in again and the reading caught up, the waiting work finished there.')



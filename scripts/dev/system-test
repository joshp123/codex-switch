# Columns the old release changes in place while it drains: a day's request counts only grow.
GROWING_COLUMNS = {'model_request_counts': ('requests', 'successful', 'failed', 'interrupted')}


def require_records_kept_and_keyed(before, goal_thread, writer):
    """Every record the old release wrote before an update is still there after it with the same contents, and every
    record of a signed-in account carries that account's key: the one it had, or the one its folder gives it."""
    signed_in = lambda folder: rig.account_key(folder) is not None
    rig.wait_for(lambda: all(row['account_key'] is not None for row in rig.account_records().values() if signed_in(row['account_name'])),
                 f'the new proxy to record account keys on the records {writer} wrote', timeout=30)
    after = rig.account_records()
    wrong = [f'{table} {identity}: {row["account_name"]} has {row["account_key"]}' for (table, identity), row in after.items()
             if signed_in(row['account_name']) and row['account_key'] != rig.account_key(row['account_name'])]
    if wrong:
        raise Failure('Records with the wrong account key, or none: ' + '; '.join(wrong[:10]))
    changed = []
    for (table, identity), original in before.items():
        now = after.get((table, identity))
        growing = GROWING_COLUMNS.get(table, ())
        unchanged = [column for column, value in original.items() if column not in growing and not (column == 'account_key' and value is None)]
        if now is None:
            changed.append(f'{table} {identity} is gone')
        elif any(now[column] != original[column] for column in unchanged):
            changed.append(f'{table} {identity} was {original}, is {now}')
        elif any(now[column] < original[column] for column in growing):
            changed.append(f'{table} {identity} counts fell from {original} to {now}')
    if changed:
        raise Failure(f'{len(changed)} of {len(before)} records {writer} wrote were lost or changed: ' + '; '.join(changed[:10]))
    goal_accounts = {row[0] for row in rig.database_rows(goal_thread)}
    if len(goal_accounts) != 1:
        raise Failure(f'The goal pinned by {writer} was served by {sorted(goal_accounts)} across the update.')
    keyed_by_folder = sum(1 for row in before.values() if row.get('account_key') is None)
    tables = sorted({table for table, _ in before})
    return (f'All {len(before)} records {writer} wrote kept their contents and folders after the update\n'
            f'({", ".join(tables)}); {keyed_by_folder} took their account keys from their folders. The goal it pinned stayed on {goal_accounts.pop()}.')


def rollback_keeps_tasks_on_their_accounts(system):
    """Rolling back to the published release after an update keeps each task on its account while new work goes elsewhere, and T3's account indexes work on either build"""
    leader = system.best_account()
    published_build = int(rig.subprocess.check_output([str(rig.RUN / 'codex-switch'), 'print-build'], text=True))
    before = rig.CodexTask('rollback-before-update', 'Reply with the word before.').finish()
    # T3 takes each account's index from whichever build serves, then reads usage with it, perhaps from the next build.
    published_indexes = rig.t3_account_indexes()
    old = rig.deploy_status()['pid']
    update = start_installer('candidate', 'rollback-update')
    wait_for_candidate(old)
    # The candidate proves itself on a turn of the published release's task, and on a task of its own.
    rig.CodexTask('rollback-turn-on-update', 'Reply with the word updated.', thread=before.thread).finish()
    during = rig.CodexTask('rollback-task-on-update', 'Reply with the word during.').finish()
    if update.wait(timeout=120):
        raise Failure(f'The update failed: {rig.read("logs/rollback-update.err")[-400:]}')
    updated = rig.deploy_status()
    if refused := rig.t3_usage_failures(published_indexes):
        raise Failure(f'After the update, the new build refused usage reads by the indexes the published release gave T3: {refused}')
    updated_indexes = rig.t3_account_indexes()
    # Another account's week resets and nothing uses it, so new work goes there: only a pin keeps a task on its account.
    runner_up = system.best_account(excluding={leader})
    system.idle.add(runner_up)
    system.weekly[runner_up] = 0
    system.apply()
    rig.wait_for(lambda: rig.usage_reads(runner_up, 0) >= 2, 'the proxy to read the idle week')
    rollback = rig.start_client([str(rig.REPO / 'deploy/deploy.sh'), 'back'], 'rollback', env=installer_environment())
    if rollback.wait(timeout=120):
        raise Failure(f'deploy.sh back failed: {rig.read("logs/rollback.err")[-400:]}')
    serving = rig.deploy_status()
    if int(serving['build']) != published_build or serving['pid'] == updated['pid']:
        raise Failure(f'After deploy.sh back, build {serving["build"]} serves; expected the published build {published_build}.')
    if refused := rig.t3_usage_failures(updated_indexes):
        raise Failure(f'After the rollback, the published release refused usage reads by the indexes the updated build gave T3: {refused}')
    turns = [rig.CodexTask('rollback-turn-after', 'Reply with the word after.', thread=before.thread).finish(),
             rig.CodexTask('rollback-task-after', 'Reply with the word again.', thread=during.thread).finish(),
             rig.CodexTask('rollback-new-task', 'Reply with the word fresh.').finish()]
    system.record_codex_task('new task after the rollback', turns[2].thread)
    new_work = rig.pinned_account(turns[2].thread)
    served = {}
    for started_by, task in (('published', before), ('updated', during)):
        label = f'task the {started_by} build started, across the update and rollback'
        system.record_codex_task(label, task.thread)
        forwarded = rig.forwarded_requests(thread=task.thread)
        require_no_replay(label, forwarded)
        served[started_by] = sorted({account for account, _ in forwarded})
    errors = [error for turn in turns for error in turn.errors]
    if any(accounts != [leader] for accounts in served.values()) or new_work != runner_up or errors:
        raise Failure(f'Across the update and rollback, the tasks pinned to {leader} were served by {served} and new work went to '
                      f'{new_work}, not {runner_up}; Codex showed {describe_errors(errors)}.')
    system.rolled_back_task, system.rolled_back_leader = during.thread, leader
    return (f'After build {updated["build"]} converted the records, deploy.sh back restored the published build {published_build}.\n'
            f'A task the published release started stayed on {served["published"][0]} through the update and back, and a task\n'
            f'the updated build started stayed on {served["updated"][0]}, while new work went to {system.describe(runner_up)}.\n'
            f'T3 read all {len(published_indexes)} accounts\' usage by the indexes each build gave it, from the other build.\n'
            f'Nothing was replayed and Codex showed no error.')


def update_after_rollback_keeps_a_task_the_published_release_moved(system):
    """A task the rolled-back published release moves off an exhausted account stays where it moved when the next update switches"""
    task, leader = system.rolled_back_task, system.rolled_back_leader
    reads = len(rig.fake_provider_events('usage-read', account=leader))
    system.limited.add(leader)
    system.apply()
    rig.wait_for(lambda: len(rig.fake_provider_events('usage-read', account=leader)) >= reads + 2, f'the published release to read {leader} exhausted')
    already = len(rig.forwarded_requests(thread=task))
    moved = rig.CodexTask('rollback-turn-exhausted', 'Reply with the word moved.', thread=task).finish()
    moved_to = sorted({account for account, _ in rig.forwarded_requests(thread=task)[already:]})
    if moved_to == [leader] or len(moved_to) != 1 or rig.pinned_account(task) != moved_to[0]:
        raise Failure(f'With {leader} exhausted, the published release sent the task\'s turn to {moved_to} and pinned it to {rig.pinned_account(task)}.')
    # The exhausted account recovers; only the pin the published release moved keeps the task off it.
    reads = len(rig.fake_provider_events('usage-read', account=leader))
    system.limited.discard(leader)
    system.apply()
    rig.wait_for(lambda: len(rig.fake_provider_events('usage-read', account=leader)) >= reads + 2, f'the published release to read {leader} available')
    old = rig.deploy_status()['pid']
    update = start_installer('candidate-2', 'update-after-rollback')
    wait_for_candidate(old)
    already = len(rig.forwarded_requests(thread=task))
    after = rig.CodexTask('rollback-turn-after-update', 'Reply with the word stayed.', thread=task).finish()
    if update.wait(timeout=120):
        raise Failure(f'The update failed: {rig.read("logs/update-after-rollback.err")[-400:]}')
    served = sorted({account for account, _ in rig.forwarded_requests(thread=task)[already:]})
    require_no_replay('The moved task', rig.forwarded_requests(thread=task))
    errors = moved.errors + after.errors
    if served != moved_to or errors:
        raise Failure(f'The published release moved the task to {moved_to[0]}; after the update its turn went to {served}'
                      + (f', and Codex showed {describe_errors(errors)}.' if errors else '.'))
    pin = next(row for (table, _), row in rig.account_records().items() if table == 'task_account_pins' and row['codex_task_id'] == task)
    if pin['account_key'] != rig.account_key(pin['account_name']):
        raise Failure(f'The moved pin names {pin["account_name"]} but stores the key {pin["account_key"]}.')
    return (f'With {leader} exhausted, the rolled-back published release moved a task to {moved_to[0]}. {leader} recovered, and after\n'
            f'the next update the task\'s turn still went to {moved_to[0]}, whose key its pin now stores. Codex showed no error.')


def retiring_proxy_keeps_only_working_connections(system):
    """After a candidate slow to start, a retiring proxy finishes its replies, closes idle connections, keeps a transferring tunnel, and is gone at the switch limit"""
    warm = rig.CodexTask('retire-warmup', 'Reply with the word ready.').finish()
    system.record_codex_task('retire warmup', warm.thread)
    old = rig.deploy_status()['pid']
    held_before = len(rig.fake_provider_events('response-held', client='codex_exec'))
    canceled_before = len(rig.fake_provider_events('response-canceled'))
    system.extra = ['hold-responses codex_exec']
    system.apply()
    held = rig.CodexTask('retire-held', 'Reply with the word held.')
    rig.wait_for(lambda: len(rig.fake_provider_events('response-held', client='codex_exec')) > held_before, 'a reply to be held', timeout=60)
    tunnels = rig.TunnelPair()
    # The switch limit counts the candidate's start, so a slow start leaves the old proxy less time to finish its
    # replies. Holding the candidate's account check makes its start as slow as on a loaded Mac.
    system.extra = ['hold-responses codex_exec', 'hold-usage-reads']
    system.apply()
    update = start_installer('candidate-2', 'retire-update')
    try:
        switch_started = int(rig.wait_for(lambda: (rig.RUN / 'data/switch-started').exists() and rig.read('data/switch-started').strip(),
                                          'the switch to begin'))
        time.sleep(max(0, switch_started + SLOW_CANDIDATE_START_SECONDS - time.time()))
        system.extra = ['hold-responses codex_exec']
        system.apply()
        new = wait_for_candidate(old)
        started_after = time.time() - switch_started
        status, completed = rig.post_without_task_id(system.base, 'Reply with the word proof.')
        if status != 200 or len(completed) != 1:
            raise Failure(f'The candidate answered {status} with {len(completed)} completed responses.')
        record_taskless_usage(system, completed)
        rig.wait_for(lambda: f'process {old} stopping' in rig.proxy_log(), 'the old proxy to begin retiring', timeout=60)
        retirement_began = time.monotonic()
        left_to_retire = switch_started + SWITCH_LIMIT_SECONDS - time.time()
        if held.process.poll() is not None:
            raise Failure('The held reply ended before retirement began.')
    finally:
        system.extra = []
        system.apply()
    try:
        held.finish()
        system.record_codex_task('reply held across retirement', held.thread)
        cut = len(rig.fake_provider_events('response-canceled')) - canceled_before
        if 'held' not in held.reply.lower() or held.errors or cut:
            killed = not rig.process_alive(old) and f'process {old} stopped after' not in rig.proxy_log()
            cause = ('the installer killed the old proxy at the switch limit' if killed
                     else 'its connection to OpenAI closed' if cut else 'it did not reach Codex')
            raise Failure(f'The held reply was cut: {cause}. Codex replied {held.reply!r}'
                          + (f' and showed {describe_errors(held.errors)}.' if held.errors else '.'))
        rig.wait_for(tunnels.idle_http_closed, 'the idle HTTP connection to close', timeout=30)
        rig.wait_for(tunnels.idle_closed, 'the silent tunnel to close', timeout=90)
        silent_for = time.monotonic() - retirement_began
        if silent_for < rig.CONNECTION_DRAIN_SECONDS * 0.8:
            raise Failure(f'The silent tunnel closed {silent_for:.0f} seconds into retirement, before its {rig.CONNECTION_DRAIN_SECONDS}-second grace.')
        while rig.process_alive(old):
            if tunnels.error:
                raise Failure(f'The transferring tunnel was cut {time.time() - switch_started:.0f} seconds after the switch began: {tunnels.error}')
            if time.time() - switch_started > SWITCH_LIMIT_SECONDS + 3:
                raise Failure(f'The old proxy did not retire within the {SWITCH_LIMIT_SECONDS}-second limit.')
            time.sleep(0.1)
        completed_after = time.time() - switch_started
    finally:
        tunnels.close()
    if completed_after < SWITCH_LIMIT_SECONDS - 2:
        raise Failure(f'The old proxy retired {completed_after:.0f} seconds after the switch began, with a tunnel still transferring.')
    if update.wait(timeout=120):
        raise Failure(f'The update command failed: {rig.read("logs/retire-update.err")[-400:]}')
    if rig.deploy_status()['pid'] != new:
        raise Failure(f'After retirement process {rig.deploy_status()["pid"]} serves, not {new}.')
    return (f'The candidate took {started_after:.0f} seconds to start, and the old proxy began retiring {left_to_retire:.0f} seconds before the limit.\n'
            f'A held reply finished on the old process. The idle HTTP connection closed at once and the silent tunnel {silent_for:.0f} seconds\n'
            f'into retirement. The transferring tunnel kept moving data until the limit, and the old process was gone {completed_after:.0f} seconds\n'
            f'after the switch began.')


def provider_outage_blocks_neither_restart_nor_release(system):
    """During a provider outage a crashed proxy restarts, and a release starts on failed work and waits instead of being skipped"""
    old = rig.deploy_status()['pid']
    build = rig.subprocess.check_output([str(rig.RUN / 'candidate-3'), 'print-build'], text=True).strip()
    system.extra = ['usage-error', 'provider-error']
    system.apply()
    try:
        os.kill(old, signal.SIGKILL)
        restarted = rig.wait_for(lambda: (status['pid'] if (status := rig.deploy_status()) and status['pid'] != old else None),
                                 'launchd to restart the proxy during the outage', timeout=60)
        update = start_installer('candidate-3', 'outage-update')
        time.sleep(2)
        if update.poll() is not None or rig.deploy_status()['pid'] != restarted:
            raise Failure('The installer did not wait for work during the outage.')
        try:
            rig.post_without_task_id(system.base, 'Provider outage test.')
        except rig.urllib.error.HTTPError as error:
            if error.code != 503:
                raise Failure(f'The simulated provider error returned HTTP {error.code}, expected 503.')
        else:
            raise Failure('The simulated provider error did not reach the client.')
        try:
            exit_code = update.wait(timeout=60)
        except rig.subprocess.TimeoutExpired:
            raise Failure('A failed request did not start the waiting update.')
    finally:
        system.extra = []
        system.apply()
    skipped = rig.read('data/skipped-builds').splitlines() if (rig.RUN / 'data/skipped-builds').exists() else []
    if not exit_code or build in skipped:
        raise Failure(f'The installer exited with {exit_code} and skipped builds are {skipped}; the release should be tried again.')
    if rig.deploy_status()['pid'] != restarted:
        raise Failure('The serving proxy changed although the candidate could not read the accounts.')
    return ('With every usage read failing, launchd restarted a killed proxy. One failed request started the waiting update; the candidate\n'
            f'could not read the accounts and stopped, and build {build} was not skipped, so the installer tries it again.')


def failed_release_steps_aside(system):
    """A release that breaks real requests steps aside and is recorded as skipped"""
    warm = rig.CodexTask('failure-warmup', 'Reply with the word ready.').finish()
    system.record_codex_task('failure warmup', warm.thread)
    old = rig.deploy_status()['pid']
    build = rig.subprocess.check_output([str(rig.RUN / 'candidate-3'), 'print-build'], text=True).strip()
    install = start_installer('candidate-3', 'bad-update')
    new = wait_for_candidate(old)
    system.extra = ['provider-error']
    system.apply()
    for number in range(3):
        try:
            rig.post_without_task_id(system.base, f'Provider error test {number}.')
        except rig.urllib.error.HTTPError as error:
            if error.code != 503:
                raise Failure(f'The simulated provider error returned HTTP {error.code}, expected 503.')
        else:
            raise Failure('The simulated provider error did not reach the client.')
    if len(rig.fake_provider_events('provider-error')) < 3 or rig.deploy_status()['failures'] != 0:
        raise Failure('Provider errors were counted against the candidate.')

    held_before = len(rig.fake_provider_events('response-held', client='codex_exec'))
    system.extra = ['hold-responses codex_exec']
    system.apply()
    canceled = rig.CodexTask('cancel-during-proof', 'Reply with the word canceled.')
    rig.wait_for(lambda: len(rig.fake_provider_events('response-held', client='codex_exec')) > held_before,
                 'a candidate response to begin before canceling', timeout=60)
    rig.stop_process_group(canceled.process)
    # The response stays held until the cancellation reaches OpenAI; released first, it would finish instead.
    rig.wait_for(lambda: rig.fake_provider_events('response-canceled', client='codex_exec'),
                 'the canceled response to close', timeout=30)
    system.extra = []
    system.apply()
    if rig.deploy_status()['pid'] != new or rig.deploy_status()['failures'] != 0:
        raise Failure('A client cancellation counted against the candidate.')

    system.extra = ['break-responses']
    system.apply()
    began = time.monotonic()
    tasks = [rig.CodexTask(f'failure-task-{number}', f'Reply with the number {number}.') for number in range(3)]
    try:
        rig.wait_for(lambda: rig.deploy_status() and rig.deploy_status()['pid'] == old,
                     'the old slot to resume serving after malformed responses', timeout=60)
    finally:
        system.extra = []
        system.apply()
    elapsed = time.monotonic() - began
    if install.wait(timeout=60):
        raise Failure(f'Failed release did not exit successfully: {rig.read("logs/bad-update.err")[-400:]}')
    for task in tasks:
        task.finish()
        system.record_codex_task(task.name, task.thread)
        require_no_replay(task.name, rig.forwarded_requests(thread=task.thread))
    skipped = (rig.RUN / 'data/skipped-builds').read_text().splitlines()
    status = rig.proxy_command('status')
    if build not in skipped or build not in status:
        raise Failure(f'Skipped build {build} is not recorded and shown in status: {status[-500:]}')
    if len(rig.fake_provider_events('malformed-response')) < 2:
        raise Failure('The fake providers did not deliver two malformed responses to the candidate.')
    return f'Build {build} stopped taking traffic after malformed responses in {elapsed:.1f} seconds; process {old} resumed, status named the skipped build, and all three Codex tasks finished.'


def queued_releases_install_newest(system):
    """Queued releases converge on the newest without overlapping switches"""
    warm = rig.CodexTask('queue-warmup', 'Reply with the word ready.').finish()
    system.record_codex_task('queue warmup', warm.thread)
    original = rig.deploy_status()['pid']
    first = start_installer('candidate-4', 'queue-first')
    wait_for_candidate(original)
    middle = start_installer('candidate-5', 'queue-middle')
    newest = start_installer('candidate-6', 'queue-newest')
    observed, process_counts = [], []
    monitoring = threading.Event()
    def observe():
        while not monitoring.wait(0.5):
            status = rig.deploy_status()
            if status:
                observed.append(int(status['build']))
            process_counts.append(len(rig.run_processes(only_servers=True)))
    observer = threading.Thread(target=observe, daemon=True)
    observer.start()
    traffic = rig.CodexTask('queue-traffic', 'Reply with the word flowing.').finish()
    system.record_codex_task('traffic during queued update', traffic.thread)
    if first.wait(timeout=60):
        raise Failure(f'First queued update failed: {rig.read("logs/queue-first.err")[-400:]}')
    expected = int(rig.subprocess.check_output([str(rig.RUN / 'candidate-6'), 'print-build'], text=True).strip())
    def newest_serving():
        # The newest installer switches on model work and proves the build on a reply of its own, so keep work coming.
        if (status := rig.deploy_status()) and int(status['build']) == expected:
            return True
        try:
            status_code, completed = rig.post_without_task_id(system.base, 'Reply with the word queued.')
        except rig.urllib.error.HTTPError:
            return False  # a proxy that is retiring may refuse it
        if status_code == 200 and completed:
            record_taskless_usage(system, completed)
        return False
    rig.wait_for(newest_serving, 'the newest build to take new connections', timeout=60, interval=0.5)
    newest_traffic = rig.CodexTask('queue-newest-traffic', 'Reply with the word newest.').finish()
    system.record_codex_task('traffic on the newest queued build', newest_traffic.thread)
    deadline = time.monotonic() + 600
    while time.monotonic() < deadline and (middle.poll() is None or newest.poll() is None):
        time.sleep(1)
    monitoring.set()
    observer.join(timeout=10)
    if process_counts and max(process_counts) > 2:
        raise Failure(f'As many as {max(process_counts)} proxy processes ran during queued updates.')
    if middle.poll() is None or newest.poll() is None or middle.returncode or newest.returncode:
        raise Failure(f'Queued installers did not finish successfully: {rig.read("logs/queue-middle.err")[-300:]} {rig.read("logs/queue-newest.err")[-300:]}')
    final = rig.deploy_status()
    if int(final['build']) != expected or observed != sorted(observed):
        raise Failure(f'Queued builds served {observed}; final build {final["build"]}, expected {expected}.')
    return f'The newest build {expected} serves after the queued installers finished; builds never went backwards and at most two proxy processes ran.'


def every_response_recorded_once(system):
    """Each completed response is recorded once, with its account, task and tokens"""
    problems, total = [], 0
    for label, task, client_usage, forwarded_requests in system.records:
        rows = rig.database_rows(task)
        total += len(rows)
        recorded, received = [row[1:] for row in rows], client_usage()
        if recorded != received:
            problems.append(f'{label}: the client received {len(received)} responses and the proxy recorded {len(recorded)}. '
                            f'Tokens (input, cached, output, reasoning): client {received}, proxy {recorded}.')
        if forwarded_requests:
            recorded_accounts, forwarded_accounts = [row[0] for row in rows], [account for account, _ in forwarded_requests()]
            if recorded_accounts != forwarded_accounts:
                problems.append(f'{label}: recorded on {recorded_accounts}, sent to OpenAI on {forwarded_accounts}.')
    unexplained = rig.database_row_count() - total
    if unexplained:
        problems.append(f'The proxy recorded {unexplained} responses that belong to no task this test ran.')
    if problems:
        raise Failure('\n'.join(problems))
    return (f'{total} responses across {len(system.records)} tasks, sessions and requests. Each was recorded once, in order, on the\n'
            f'account its request was sent on, under its task, with the input, cached, output and reasoning tokens the client received.')


def require_no_replay(label, forwarded):
    fingerprints = [fingerprint for _, fingerprint in forwarded]
    if len(set(fingerprints)) != len(fingerprints):
        raise Failure(f'{label} sent {len(fingerprints) - len(set(fingerprints))} model requests to OpenAI a second time.')


def describe_errors(errors):
    """Codex's own words for each error it showed, from app-server notifications or `codex exec` events."""
    shown = []
    for error in errors:
        detail = error.get('params', {}).get('error') or error.get('error') or error
        message = detail.get('message', '') if isinstance(detail, dict) else str(detail)
        cause = detail.get('additionalDetails') or '' if isinstance(detail, dict) else ''
        shown.append(f'"{message}" ({cause.split(", url:")[0]})' if cause else f'"{message}"')
    return ', '.join(shown)


def format_duration(seconds):
    minutes, seconds = divmod(round(seconds), 60)
    return f'{minutes}m {seconds:02d}s'


BUILD_DESCRIPTIONS = {'cli': 'This build', 'published-release': 'The published release'}


def reset_command(build, *args):
    """Runs the CLI of build ('cli' for this tree's build, or the published release's proxy) against the fake providers."""
    executable = rig.PUBLISHED_RELEASE_PROXY if build == 'published-release' else rig.RUN / build
    return subprocess.run([str(executable), *args], env=dict(os.environ, **rig.proxy_environment()), capture_output=True, text=True, timeout=15)


def reset_credits():
    """One credit on each Codex account. account-2's expires first, but account-3 refills last (System.resets), so it has
    the most of its week left: this build spends account-3's credit, and the published release, which took the credit
    that expires first, spent account-2's."""
    now = int(time.time())
    return [f'credit account-1 credit-account-1 {now + 3 * DAY}', f'credit account-2 credit-account-2 {now + 2 * DAY}',
            f'credit account-3 credit-account-3 {now + 4 * DAY}']


# The credit each build spends from reset_credits when every account is out.
CHOSEN_CREDIT = {'cli': ('account-3', 'credit-account-3'), 'published-release': ('account-2', 'credit-account-2')}


def lose_a_reset_and_retry(system, lost_by, retried_by):
    """Exhausts the pool, lets lost_by spend the credit it chooses while the provider drops its reply, then retries with
    retried_by. Returns the claims the provider saw, which must be the same credit and request ID twice."""
    system.limited = set(system.accounts)
    system.extra = ['reset-drop']
    system.apply()
    lost = reset_command(lost_by, 'reset', 'codex')
    if lost.returncode == 0 or 'outcome unknown' not in lost.stderr:
        raise Failure(f'{BUILD_DESCRIPTIONS[lost_by]} losing a reset reply: {lost.stdout} {lost.stderr}')
    system.extra = []
    system.apply()
    retry = reset_command(retried_by, 'reset', 'codex')
    if retry.returncode or 'spent, by an earlier try of this request' not in retry.stdout:
        raise Failure(f'{BUILD_DESCRIPTIONS[retried_by]} retrying the reset {BUILD_DESCRIPTIONS[lost_by].lower()} left pending: {retry.stdout} {retry.stderr}')
    claims = re.findall(r'event=reset-claim account=(\S+) credit=(\S+) request=(\S+)', rig.read('logs/fake-providers.log'))
    if len(claims) != 2 or claims[0] != claims[1] or claims[0][:2] != CHOSEN_CREDIT[lost_by]:
        raise Failure(f'Expected two identical claims for {CHOSEN_CREDIT[lost_by][1]}; got {claims}')
    return claims


def stored_resets(system):
    """An agent spends a reset only when the pool is exhausted, and safely retries a response lost by the published
    release, as after an update"""
    def command(*args):
        return reset_command('cli', *args)
    status = command('status')
    if status.returncode or status.stdout.count('holds 1 weekly reset · expires ') != 3:
        raise Failure(f'Status did not list each Codex account\'s reset with its expiry: {status.stdout} {status.stderr}')
    (rig.RUN / 'reset-status.txt').write_text(status.stdout)
    claude = command('reset', 'claude')
    if claude.returncode or 'spends no Claude reset' not in claude.stdout:
        raise Failure(f'Claude reset: {claude.stdout} {claude.stderr}')
    available = command('reset', 'codex')
    if available.returncode or 'can take work' not in available.stdout:
        raise Failure(f'Available pool: {available.stdout} {available.stderr}')
    system.limited = set(system.accounts)
    system.extra = ['reset-soon']
    system.apply()
    soon = command('reset', 'codex')
    if soon.returncode or 'within 30 minutes' not in soon.stdout:
        raise Failure(f'Near reset: {soon.stdout} {soon.stderr}')
    if 'event=reset-claim' in rig.read('logs/fake-providers.log'):
        raise Failure('A credit was spent while an account was available or returning soon.')
    system.extra = ['reset-refuse']
    system.apply()
    refused = command('reset', 'codex')
    if refused.returncode == 0 or 'outcome unknown' not in refused.stderr:
        raise Failure(f'Refused redemption: {refused.stdout} {refused.stderr}')
    system.limited = set(system.accounts) - {'account-1'}
    system.extra = []
    system.apply()
    recovered = command('reset', 'codex')
    if recovered.returncode or 'can take work' not in recovered.stdout:
        raise Failure(f'Retry after capacity returned: {recovered.stdout} {recovered.stderr}')
    if 'event=reset-claim' in rig.read('logs/fake-providers.log'):
        raise Failure('A retry spent a credit after another account could work again.')
    lose_a_reset_and_retry(system, lost_by='published-release', retried_by='cli')
    # A reset account has used nothing.
    rig.wait_for(lambda: rig.usage_reads('account-2', 0), 'the proxy to observe the reset account')
    task = rig.CodexTask('reset-resumed-work', 'Reply with the word resumed.').finish()
    system.record_codex_task('work after reset', task.thread)
    if rig.pinned_account(task.thread) != 'account-2':
        raise Failure(f'Work after the reset used {rig.pinned_account(task.thread)}, not the reset account.')
    return 'Status listed each Codex account\'s reset with its expiry; available and near-reset pools spent none. A refused redemption spent nothing once another account could work. This build retried the response the published release lost with the same request ID, and work resumed on that account.'


def automatic_resets(on, data=None):
    """Turns automatic resets on or off for the installation in data, this Mac's by default, as a person does."""
    result = subprocess.run([str(rig.RUN / 'cli'), 'auto-reset', 'codex', 'on' if on else 'off'], capture_output=True, text=True, timeout=15,
                            env=dict(rig.client_environment(), CODEX_SWITCH_DATA_DIR=str(data or rig.RUN / 'data')))
    if result.returncode:
        raise Failure(f'codex-switch auto-reset failed: {result.stderr}')


WAITING_WITHOUT_RESETS = 'Automatic Codex resets are off, so no reset credit is spent for it.'
READING_LAGS = 'does not show the reset of Codex'


def spends():
    """(account, credit) for every credit OpenAI spent."""
    return [(event['account'], event['credit']) for event in rig.fake_provider_events('reset-reset')]


def wait_until_every_account_reads_limited(*others):
    limited = 'OpenAI reports its usage limit reached'
    rig.wait_for(lambda: rig.proxy_log().count(limited) >= 3 and all(other.proxy_log().count(limited) >= 3 for other in others),
                 'every proxy to read every account as limited')


def resumed_on_the_reset_account(here, there=None, other=None):
    here.finish()
    if there:
        there.finish()
    resumed = (rig.pinned_account(here.thread), other.pinned_account_key(there.thread) if there else rig.account_key('account-3'))
    if resumed != ('account-3', rig.account_key('account-3')):
        raise Failure(f'Work resumed on {resumed}, not on the reset account.')


def only_the_authority_spends_one_credit(system):
    """With every Codex account out and work waiting on two Macs, only the Mac with automatic resets on spends a credit.
    It spends none while an account refills within 30 minutes, then one, on the account with the most of its week left,
    and no other while OpenAI's usage reading lags behind the spend; nor does the reset command. Work on both Macs
    resumes once the reading catches up"""
    status = rig.proxy_command('status')
    if status.count('holds 1 weekly reset · expires ') != 3 or 'Automatic Codex resets: off' not in status:
        raise Failure(f'Status did not show each Codex account\'s reset credit and automatic resets off:\n{status}')
    automatic_resets(True)
    if 'Automatic Codex resets: on' not in (status := rig.proxy_command('status')):
        raise Failure(f'After `codex-switch auto-reset codex on`, status showed:\n{status}')
    other = rig.OtherMac()
    system.limited = set(system.accounts)
    system.extra = ['reset-soon']  # account-2 refills five minutes from each read
    system.apply()
    wait_until_every_account_reads_limited(other)
    here = rig.CodexTask('waiting-here', 'Reply with the word here.')
    there = other.codex_task('waiting-there', 'Reply with the word there.')
    rig.wait_for(lambda: 'within 30 minutes.' in rig.proxy_log() and WAITING_WITHOUT_RESETS in other.proxy_log(),
                 'this Mac to keep its credits while an account refills within 30 minutes, and the other to wait')
    if rig.fake_provider_events('reset-claim'):
        raise Failure('A proxy asked to spend a credit while an account would refill within 30 minutes.')
    system.extra = ['usage-lag']
    system.apply()
    rig.wait_for(lambda: len(spends()) > 1 or (spends() and READING_LAGS in rig.proxy_log()),
                 'this Mac to spend a credit, then wait for OpenAI\'s reading to show it')
    reset = reset_command('cli', 'reset', 'codex')
    if reset.returncode or READING_LAGS not in reset.stdout:
        raise Failure(f'The reset command, with the reading lagging: {reset.stdout} {reset.stderr}')
    claims = rig.fake_provider_events('reset-claim')
    if spends() != [CHOSEN_CREDIT['cli']] or len(claims) != 1:
        raise Failure(f'Expected one request, spending {CHOSEN_CREDIT["cli"][1]}; OpenAI saw {claims} and spent {spends()}.')
    if 'Reset credit' in other.proxy_log():
        raise Failure('The Mac with automatic resets off decided about a credit.')
    system.extra = []
    system.apply()
    resumed_on_the_reset_account(here, there, other)
    system.record_codex_task('work waiting on this Mac', here.thread)
    said = next(line for line in rig.proxy_log().splitlines() if READING_LAGS in line)
    return (f'While account-2 would refill within 30 minutes, this Mac kept its credits and the other Mac, with automatic resets '
            f'off, logged that its work waits. Then this Mac alone asked OpenAI once, for {CHOSEN_CREDIT["cli"][1]}, the credit '
            f'of the account that refills last. While the reading still showed account-3 at its limit, it and the reset command '
            f'spent nothing more; it logged:\n{said.split(" ", 1)[1]}\nOnce the reading caught up, the work on both Macs finished on account-3.')


def a_mac_started_after_a_spend_spends_nothing(system):
    """A Mac with automatic resets off that starts after the other Mac spent a credit, while OpenAI's usage reading
    still shows every account out and work waits on it, spends none"""
    automatic_resets(True)
    system.limited = set(system.accounts)
    system.extra = ['usage-lag']
    system.apply()
    wait_until_every_account_reads_limited()
    here = rig.CodexTask('waiting-here', 'Reply with the word here.')
    rig.wait_for(lambda: len(spends()) > 1 or (spends() and READING_LAGS in rig.proxy_log()),
                 'this Mac to spend a credit, then wait for OpenAI\'s reading to show it')
    other = rig.OtherMac()
    there = other.codex_task('waiting-there', 'Reply with the word there.')
    rig.wait_for(lambda: WAITING_WITHOUT_RESETS in other.proxy_log(), 'the Mac started afterwards to have work waiting')
    if len(rig.fake_provider_events('reset-claim')) != 1 or spends() != [CHOSEN_CREDIT['cli']]:
        raise Failure(f'Expected one spend, of {CHOSEN_CREDIT["cli"][1]}; OpenAI saw {rig.fake_provider_events("reset-claim")}.')
    system.extra = []
    system.apply()
    resumed_on_the_reset_account(here, there, other)
    system.record_codex_task('work waiting on this Mac', here.thread)
    return (f'This Mac spent {CHOSEN_CREDIT["cli"][1]}. A second Mac started afterwards, read every account still out, and '
            f'with work waiting logged "{WAITING_WITHOUT_RESETS}" OpenAI saw one request to spend a credit; once its reading '
            f'caught up, the work on both Macs finished on account-3.')


def no_credit_is_spent_while_the_authority_is_off(system):
    """While the Mac with automatic resets on is off, no credit is spent: work waits with every Codex account out, and
    resumes when one refills"""
    system.limited = set(system.accounts)
    system.apply()
    wait_until_every_account_reads_limited()
    task = rig.CodexTask('waiting-for-a-refill', 'Reply with the word refilled.')
    rig.wait_for(lambda: WAITING_WITHOUT_RESETS in rig.proxy_log(), 'the proxy to have work waiting')
    system.limited.discard('account-1')
    system.apply()
    task.finish()
    system.record_codex_task('work waiting for a refill', task.thread)
    if rig.fake_provider_events('reset-claim') or rig.pinned_account(task.thread) != 'account-1':
        raise Failure(f'Work finished on {rig.pinned_account(task.thread)}; OpenAI saw requests to spend {rig.fake_provider_events("reset-claim")}.')
    return (f'With every account out and a credit on each, the proxy, with automatic resets off, logged "{WAITING_WITHOUT_RESETS}" '
            'and asked OpenAI for none. When account-1 refilled, the work finished there.')


def expiring_credits():
    """Two credits on account-1 in their last hour, the first expiring sooner."""
    now = int(time.time())
    return [f'credit account-1 expiring-first {now + 1800}', f'credit account-1 expiring-second {now + 2400}']


def expiring_credit_is_spent_once_by_the_authority(system):
    """Of two Macs, only the one with automatic resets on spends a credit in its last hour. It keeps the credit while
    its account has used 20% of its week or less, or no more than the share of the week that has passed, without
    asking OpenAI; then spends it once"""
    automatic_resets(True)
    other = rig.OtherMac()
    rig.wait_for(lambda: 'has used 15% of its week, and a credit about to expire is spent only above 20%' in rig.proxy_log(),
                 'this Mac to keep the credit of an account that has used little of its week')
    system.weekly['account-1'], system.resets['account-1'] = 40, int(time.time() + 3.5 * DAY)
    system.apply()
    rig.wait_for(lambda: 'has used 40% of its week, no more than the 50% of the week that has passed' in rig.proxy_log(),
                 'this Mac to keep the credit of an account behind its week')
    if rig.fake_provider_events('reset-claim'):
        raise Failure('OpenAI was asked to spend a credit that gains less than it loses.')
    system.weekly['account-1'] = 60
    system.apply()
    # Once the first credit is spent the account has used nothing, so the second is kept.
    rig.wait_for(lambda: 'Keeping reset credit expiring-second' in rig.proxy_log() and 'has used 0% of its week' in rig.proxy_log(),
                 'this Mac to spend the first credit, then keep the second')
    claims = rig.fake_provider_events('reset-claim')
    if spends() != [('account-1', 'expiring-first')] or len({claim['request'] for claim in claims}) != len(claims):
        raise Failure(f'Expected one spend of expiring-first, each request under its own ID; OpenAI saw {claims} and spent {spends()}.')
    if 'Reset credit' in other.proxy_log() or 'Keeping reset credit' in other.proxy_log() or 'Automatic Codex resets are off' not in other.proxy_log():
        raise Failure('The Mac with automatic resets off decided about a credit.')
    return ('At 15% used, and at 40% used with half the week gone, this Mac kept the expiring credit without asking OpenAI. At 60% '
            f'it asked and OpenAI spent it, once, in {len(claims)} request; the account\'s second credit was then kept. '
            'The other Mac, with automatic resets off, decided nothing.')


def unconfirmed_reset_does_not_hold_work_for_ever(system):
    """When OpenAI's usage reading has not shown a spent reset after 30 minutes, the waiting work draws usage credits, and
    no second reset credit is spent"""
    automatic_resets(True)
    system.limited = set(system.accounts)
    system.extra = ['usage-lag']
    system.apply()
    wait_until_the_proxy_reads(*system.accounts)
    task = rig.CodexTask('work-behind-a-lagging-reset', 'Reply with the word drawn.')
    rig.wait_for(spends, 'the proxy to spend a reset credit')
    unconfirmed = rig.RUN / 'data/unconfirmed-reset.json'
    record = json.loads(unconfirmed.read_text())
    asked = datetime.datetime.fromisoformat(record['AskedAt'].replace('Z', '+00:00')) - datetime.timedelta(minutes=31)
    record['AskedAt'] = asked.isoformat().replace('+00:00', 'Z')
    unconfirmed.write_text(json.dumps(record))  # as if the reading had lagged for 31 minutes
    task.finish()
    system.record_codex_task('work behind a lagging reset', task.thread)
    if len(spends()) != 1 or not draws():
        raise Failure(f'OpenAI spent {spends()}; usage credits drawn: {draws()}.')
    return f'One reset credit was spent and OpenAI\'s reading never showed it. 31 minutes on, the work finished on usage credits and no other credit was spent.'


def refused_expiring_credit_is_not_asked_for_in_a_loop(system):
    """When OpenAI finds nothing to reset with a credit about to expire, the proxy asks once and waits before it asks again"""
    automatic_resets(True)
    rig.wait_for(lambda: 'It is asked again after' in rig.proxy_log(), 'the proxy to say when it asks about the expiring credit again')
    reads = len(rig.fake_provider_events('usage-read', account='account-1'))
    rig.wait_for(lambda: len(rig.fake_provider_events('usage-read', account='account-1')) >= reads + 5, 'five more account reads')
    claims = rig.fake_provider_events('reset-claim')
    if len(claims) != 1 or spends():
        raise Failure(f'OpenAI was asked {len(claims)} times and spent {spends()}.')
    return 'OpenAI found nothing to reset with the expiring credit. Over the next five account reads the proxy did not ask again.'


def rollback_and_back_spends_no_second_credit(system):
    """Rolling the Mac with automatic resets on back to the published release and forward again, while a spend's
    outcome is unknown and OpenAI's usage reading lags, spends no second credit: the published release's reset command
    finishes the pending reset, and work resumes on the reset account once the reading catches up"""
    automatic_resets(True)
    published_build = int(subprocess.check_output([str(rig.RUN / 'codex-switch'), 'print-build'], text=True))
    # An update waits for model work.
    system.record_codex_task('work before the update', rig.CodexTask('authority-before-update', 'Reply with the word before.').finish().thread)
    old = rig.deploy_status()['pid']
    update = start_installer('candidate', 'authority-update')
    wait_for_candidate(old)
    system.record_codex_task('proof of the update', rig.CodexTask('authority-update-proof', 'Reply with the word updated.').finish().thread)
    if update.wait(timeout=120):
        raise Failure(f'The update failed: {rig.read("logs/authority-update.err")[-400:]}')
    # OpenAI spends the credit, but every reply to a request to spend one is lost.
    system.limited = set(system.accounts)
    system.extra = ['usage-lag', 'reset-drop']
    system.apply()
    wait_until_every_account_reads_limited()
    waiting = rig.CodexTask('waiting-before-rollback', 'Reply with the word lost.')
    rig.wait_for(lambda: len(rig.fake_provider_events('reset-claim')) >= 2 and 'outcome unknown' in rig.proxy_log(),
                 'the updated build to spend a credit, lose the reply, and retry')
    rig.stop_process_group(waiting.process)
    rollback = rig.start_client([str(rig.REPO / 'deploy/deploy.sh'), 'back'], 'authority-rollback', env=installer_environment())
    if rollback.wait(timeout=120):
        raise Failure(f'deploy.sh back failed: {rig.read("logs/authority-rollback.err")[-400:]}')
    if int(rig.deploy_status()['build']) != published_build:
        raise Failure(f'After deploy.sh back, build {rig.deploy_status()["build"]} serves, not the published build {published_build}.')
    system.extra = ['usage-lag']
    system.apply()
    finished = reset_command('published-release', 'reset', 'codex')
    if finished.returncode or (rig.RUN / 'data/pending-reset.json').exists():
        raise Failure(f'The published release did not finish the pending reset: {finished.stdout} {finished.stderr}')
    # Work on account-1 lets the next update start and the updated build prove itself; then every account is out again
    # while the reading still lags.
    system.limited = set(system.accounts) - {'account-1'}
    system.apply()
    system.record_codex_task('work after the rollback', rig.CodexTask('authority-after-rollback', 'Reply with the word back.').finish().thread)
    old = rig.deploy_status()['pid']
    update = start_installer('candidate-2', 'authority-update-again')
    wait_for_candidate(old)
    system.record_codex_task('proof of the second update', rig.CodexTask('authority-update-again-proof', 'Reply with the word again.').finish().thread)
    if update.wait(timeout=120):
        raise Failure(f'The second update failed: {rig.read("logs/authority-update-again.err")[-400:]}')
    reads = len(rig.fake_provider_events('usage-read', account='account-1'))
    system.limited = set(system.accounts)
    system.apply()
    rig.wait_for(lambda: len(rig.fake_provider_events('usage-read', account='account-1')) >= reads + 2, 'the updated build to read account-1 as limited')
    here = rig.CodexTask('waiting-after-update', 'Reply with the word here.')
    rig.wait_for(lambda: len(spends()) > 1 or READING_LAGS in rig.proxy_log(), 'the updated build to wait for OpenAI\'s reading to show the spend')
    if spends() != [CHOSEN_CREDIT['cli']]:
        raise Failure(f'Expected one spend, of {CHOSEN_CREDIT["cli"][1]}; OpenAI spent {spends()}.')
    system.extra = []
    system.apply()
    resumed_on_the_reset_account(here)
    system.record_codex_task('work waiting after the rollback and update', here.thread)
    said = next(line for line in reversed(rig.proxy_log().splitlines()) if READING_LAGS in line)
    return (f'The updated build spent {CHOSEN_CREDIT["cli"][1]} and lost the reply. After deploy.sh back, the published release '
            f'spent nothing by itself, and its reset command finished the pending reset: "{finished.stdout.strip()}" After the '
            f'next update the build logged:\n{said.split(" ", 1)[1]}\nOpenAI spent one credit; the work finished on account-3 once the reading caught up.')


# Each Codex account's usage credits at the start: OpenAI's free grant of 62,500, one account having drawn a little, and
# one near the 2,000 floor.
USAGE_CREDITS = {'account-1': 62500, 'account-2': 62427.76, 'account-3': 2350}
STARTS_DRAWING, STOPS_DRAWING = 'starts drawing its usage credits', 'stops drawing its usage credits'


def credit_balance(account):
    """The account's usage credit balance as OpenAI last reported it."""
    reads = [event for event in rig.fake_provider_events('usage-read', account=account) if 'credits' in event]
    return float(reads[-1]['credits'])


def draws(account=None):
    """The usage credits OpenAI drew for model requests, as (account, balance after) pairs."""
    return [(event['account'], float(event['balance'])) for event in rig.fake_provider_events('usage-credits-drawn')
            if account in (None, event['account'])]


def wait_until_the_proxy_reads(*accounts, balance=None, used=100):
    """Waits until the proxy has applied a usage read of each account, answered from now on, at this weekly level and
    credit balance: the read after the first one OpenAI answered with them."""
    earlier = {account: len(rig.fake_provider_events('usage-read', account=account)) for account in accounts}
    def read(account):
        return len([event for event in rig.fake_provider_events('usage-read', account=account)[earlier[account]:] if float(event['used']) == used
                    and (balance is None or float(event.get('credits', 'nan')) == balance)]) >= 2
    rig.wait_for(lambda: all(read(account) for account in accounts), f'the proxy to read {", ".join(accounts)} at {used}% used'
                 + ('' if balance is None else f' with {balance:g} usage credits'))


def proxy_log_lines(text):
    """The proxy log's lines that hold text, without their times."""
    return [line.split(' ', 1)[1] for line in rig.proxy_log().splitlines() if text in line]


def status_shows_each_accounts_usage_credits(system):
    """Status shows each Codex account's usage credit balance"""
    status = rig.proxy_command('status')
    shown = ['usage credits: 62,500', 'usage credits: 62,428', 'usage credits: 2,350']
    if any(line not in status for line in shown):
        raise Failure(f'Status did not show {shown}:\n{status}')
    return 'Status showed ' + ', '.join(f'"{line}"' for line in shown) + ' for the three Codex accounts.'


def usage_credits_wait_while_an_account_has_included_allowance(system):
    """While one Codex account has included allowance left, work goes to it, and no account draws its usage credits,
    although OpenAI would let the others"""
    system.limited = {'account-1', 'account-2'}
    system.apply()
    wait_until_the_proxy_reads(*system.limited)
    task = rig.CodexTask('included-allowance-first', 'Reply with the word included.').finish()
    system.record_codex_task('work on included allowance', task.thread)
    if rig.pinned_account(task.thread) != 'account-3' or draws() or STARTS_DRAWING in rig.proxy_log():
        raise Failure(f'The task went to {rig.pinned_account(task.thread)}; OpenAI drew usage credits {draws()}.')
    return ('account-1 and account-2 used up their weekly allowance; OpenAI still reported both allowed, as it does while an '
            'account holds usage credits. The task went to account-3, which had allowance left, and no usage credits were drawn.')


def usage_credits_are_drawn_when_every_allowance_is_out(system):
    """With every Codex account's included allowance used up, on a Mac with automatic resets off, work draws the usage
    credits of the account with the largest balance, the log says so, and status shows the account drawing"""
    system.limited = set(system.accounts)
    system.apply()
    wait_until_the_proxy_reads(*system.accounts)
    task = rig.CodexTask('usage-credits-drawn', 'Reply with the word drawn.').finish()
    system.record_codex_task('work on usage credits', task.thread)
    drawn = draws()
    if rig.pinned_account(task.thread) != 'account-1' or not drawn or {account for account, _ in drawn} != {'account-1'}:
        raise Failure(f'The task went to {rig.pinned_account(task.thread)}; OpenAI drew usage credits {drawn}.')
    started = proxy_log_lines(STARTS_DRAWING)
    if len(started) != 1 or not started[0].startswith('Codex 1 starts drawing its usage credits at 62,500'):
        raise Failure(f'The proxy logged {started} for the start of drawing.')
    wait_until_the_proxy_reads('account-1', balance=drawn[-1][1])
    status = rig.wait_for(lambda: next((text for text in [rig.proxy_command('status')] if 'available, drawing its usage credits' in text), None),
                          'status to show account-1 drawing its usage credits')
    if rig.fake_provider_events('reset-claim'):
        raise Failure('A reset credit was spent on a Mac with automatic resets off.')
    shown = next(line for line in status.splitlines() if 'drawing its usage credits' in line)
    return (f'The task went to account-1, the largest balance; OpenAI drew {len(drawn)} model request(s) from it. The proxy logged:\n'
            f'{started[0]}\nStatus showed: {shown.strip()}')


def usage_credits_stop_at_the_floor(system):
    """New work stops when the observed balance reaches 2,000; in-flight work stays above 1,000"""
    # Only account-3 holds usage credits now, 2,350 of them.
    system.usage_credits = {'account-3': USAGE_CREDITS['account-3']}
    system.apply()
    wait_until_the_proxy_reads('account-1', 'account-2')
    wait_until_the_proxy_reads('account-3', balance=2350)
    with simulating(system, 'hold-usage-reads'):
        for number in range(5):
            task = rig.CodexTask(f'floor-burst-{number}', 'Reply with the word floor.').finish()
            system.record_codex_task(f'burst work {number}', task.thread)
    served = 5
    wait_until_the_proxy_reads('account-3', balance=1850)
    waits_before = rig.proxy_log().count('no account can take this work')
    drawn_before = len(draws('account-3'))
    task = rig.CodexTask('after-credit-floor', 'Reply with the word waiting.')
    rig.wait_for(lambda: rig.proxy_log().count('no account can take this work') > waits_before,
                 'new work to wait at the credit floor')
    if len(draws('account-3')) != drawn_before:
        raise Failure('New work drew credits after the balance was read below the cutoff.')
    stopped = rig.wait_for(lambda: proxy_log_lines('Codex 3 ' + STOPS_DRAWING), 'the proxy to log that account-3 stops drawing')[0]
    final = credit_balance('account-3')
    system.limited.discard('account-2')
    system.apply()
    task.finish()
    system.record_codex_task('work after the floor', task.thread)
    if final <= 1000 or any(balance <= 1000 for _, balance in draws('account-3')) or rig.pinned_account(task.thread) != 'account-2':
        raise Failure(f'account-3\'s usage credits went to {[balance for _, balance in draws("account-3")]}; the work that waited '
                      f'went to {rig.pinned_account(task.thread)}.')
    return (f'account-3 drew from 2,350 to {final:,.0f} over {served} task(s); the next task waited until account-2 refilled, '
            f'and finished there. The proxy logged:\n{stopped}')


def low_credit_balance_leaves_included_allowance_usable(system):
    """An account with no usage credits left still takes work on its included allowance"""
    first = system.best_account()
    system.usage_credits = {first: 0}
    system.apply()
    wait_until_the_proxy_reads(first, balance=0, used=system.weekly[first])
    rig.wait_for(lambda: 'usage credit balance 0 is below 1,000' in rig.proxy_log(), 'the proxy to note the empty balance')
    task = rig.CodexTask('empty-balance-with-allowance', 'Reply with the word working.').finish()
    system.record_codex_task('work on included allowance with no usage credits', task.thread)
    if rig.pinned_account(task.thread) != first or draws():
        raise Failure(f'With no usage credits on {first}, which has allowance left, work went to {rig.pinned_account(task.thread)} and drew {draws()}.')
    system.usage_credits = {}
    system.apply()
    return f'{system.describe(first)}, held no usage credits. New work still went to it, and no usage credits were drawn.'


def low_credit_balance_blocks_until_weekly_reset(system):
    """A balance below 1,000 blocks an account even if it later reports enough credit and allowed work"""
    system.limited = set(system.accounts)
    system.usage_credits = {'account-3': 900}
    system.apply()
    wait_until_the_proxy_reads('account-3', balance=900)
    rig.wait_for(lambda: 'usage credit balance 900 is below 1,000' in rig.proxy_log(), 'the low balance warning')
    system.usage_credits = {'account-3': 4000}
    system.apply()
    wait_until_the_proxy_reads('account-3', balance=4000)
    before = len(draws())
    task = rig.CodexTask('low-credit-lockout', 'Reply with the word waiting.')
    rig.wait_for(lambda: 'usage credit balance fell below 1,000' in rig.proxy_log(), 'work to wait for the weekly reset')
    if len(draws()) != before:
        raise Failure('The locked account drew more credits.')
    system.limited.discard('account-2')
    system.apply()
    task.finish()
    system.record_codex_task('work during low-credit lockout', task.thread)
    if rig.pinned_account(task.thread) != 'account-2':
        raise Failure('Work went to the locked account.')
    return 'At 900 credits the account was blocked until its weekly reset. A later 4,000-credit reading did not unblock it; work resumed on account-2.'


def refused_reset_lets_work_draw_usage_credits(system):
    """When OpenAI finds nothing to reset for a pool that is out, the Mac with automatic resets on asks once, and the
    waiting work goes on by drawing usage credits"""
    automatic_resets(True)
    system.limited = set(system.accounts)
    system.apply()
    wait_until_the_proxy_reads(*system.accounts)
    task = rig.CodexTask('reset-refused-work', 'Reply with the word drawn.').finish()
    system.record_codex_task('work after a refused reset', task.thread)
    claims = rig.fake_provider_events('reset-claim')
    if len(claims) != 1 or spends() or not draws() or 'found nothing to reset' not in rig.proxy_log():
        raise Failure(f'OpenAI was asked to spend a credit {len(claims)} times and spent {spends()}; usage credits drawn: {draws()}.')
    return f'OpenAI found nothing to reset. The proxy asked once, kept the credit, and the work finished on usage credits ({len(draws())} draws).'


def reset_credits_come_first(system):
    """On the Mac with automatic resets on, with every Codex account's included allowance used up, a reset credit is
    spent before any account draws its usage credits"""
    drawn_before = len(draws())
    system.limited = set(system.accounts)
    system.usage_credits = dict(USAGE_CREDITS)
    system.apply()
    wait_until_the_proxy_reads(*system.accounts)
    automatic_resets(True)
    task = rig.CodexTask('reset-before-usage-credits', 'Reply with the word reset.').finish()
    system.record_codex_task('work after the reset', task.thread)
    if spends() != [('account-3', 'credit-account-3')] or len(draws()) != drawn_before or rig.pinned_account(task.thread) != 'account-3':
        raise Failure(f'OpenAI spent reset credits {spends()} and drew usage credits {draws()[drawn_before:]}; '
                      f'the task went to {rig.pinned_account(task.thread)}.')
    return ('With every account out, account-1 holding 62,400 usage credits and account-3 a reset credit, the proxy spent the '
            'reset credit and the task went to account-3. No usage credits were drawn.')


def no_part_of_a_token_reaches_the_log(system):
    """When OpenAI's reason for refusing or failing a request quotes the request's access token where the proxy shortens
    what it logs, the proxy log holds no part of the token"""
    with simulating(system, 'token-quoting-error'):
        try:
            rig.post_without_task_id(system.base, 'Reply with the word refused.')
        except urllib.error.HTTPError as refused:
            refused.read()
        try:
            urllib.request.urlopen(f'{system.base}/models?client_version=1.0.0', timeout=30).read()
        except urllib.error.HTTPError as refused:
            refused.read()
        quoted = rig.wait_for(lambda: [line for line in rig.proxy_log().splitlines() if 'with HTTP 503' in line and 'Rejected Bearer' in line]
                              if len(rig.fake_provider_events('token-quoting-error')) >= 2 else None, 'the proxy to log both refusals')
    with simulating(system, 'token-quoting-failure'):
        rig.post_without_task_id(system.base, 'Reply with the word failed.')
        quoted += rig.wait_for(lambda: [line for line in rig.proxy_log().splitlines() if 'OpenAI failed the' in line and 'Rejected' in line],
                               'the proxy to log the failed response')
    leaked = rig.credential_pieces(rig.proxy_log(), system.credentials)
    if len(quoted) < 3 or leaked:
        raise Failure('The proxy logged a token, or part of one:\n' + '\n'.join(line for line, _ in leaked))
    return ('OpenAI quoted the access token across the 300 bytes of a reason the log keeps, across the 4096 bytes the proxy reads of '
            'another body, and in the reason it failed a response. The proxy logged:\n' + '\n'.join(line.split(' ', 1)[1] for line in quoted))



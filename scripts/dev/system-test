import system_test_rig as rig  # noqa: E402
from system_test_rig import Failure  # noqa: E402

# The fake providers' model follows these scripts, one line per model request.
SUM = "awk '{{s += $1}} END {{print s}}' input.txt > {result}"
GOAL = ('Follow this script.\nRUN: printf \'START\\n\' >> {effect}\nRUN: ' + SUM + '\nGOAL COMPLETE\nREPLY: done')
# The tool call runs until the test creates {release}, so it spans the update.
SLEEPING_GOAL = ('Follow this script.\nRUN: printf \'START\\n\' >> {effect} && while [ ! -e {release} ]; do sleep 0.05; done\nRUN: ' + SUM
                 + '\nGOAL COMPLETE\nREPLY: done')
# The real installer with shorter timers. Macs prove a build for five minutes
# and finish a switch within 30.
PROVING_SECONDS, SWITCH_LIMIT_SECONDS = 1, 6


class System:
    """What the test has told the fake providers, and every task whose responses must be recorded."""

    def __init__(self, accounts):
        self.accounts, self.base = accounts, None
        # Distinct weekly resets, so exactly one account's allowance resets first. It is
        # also the account with the least left, which the rule must not prefer.
        self.weekly = {account: max(5, 90 - 10 * number) for number, account in enumerate(accounts, 1)}
        self.resets = {account: int(time.time()) + number * 86400 for number, account in enumerate(accounts, 1)}
        self.limited, self.idle, self.extra, self.records, self.taskless_usage = set(), set(), [], [], []
        self.records.append(('requests without a task ID', '', lambda: self.taskless_usage,
                             lambda: rig.forwarded_requests(thread='', session='', client='')))

    def apply(self):
        rig.control(*[f'weekly-used {account} {used}' for account, used in self.weekly.items()],
                    *[f'weekly-resets {account} {at}' for account, at in self.resets.items()],
                    *[f'weekly-idle {account}' for account in sorted(self.idle)],
                    *[f'limited {account}' for account in sorted(self.limited)], *self.extra)

    def best_account(self, excluding=()):
        """The rule under test: an account whose week has not started, then the weekly allowance that resets first."""
        candidates = [account for account in self.accounts if account not in self.limited | set(excluding)]
        if not candidates:
            raise Failure('No account with a weekly allowance is available.')
        return min(candidates, key=lambda account: (account not in self.idle, self.resets[account]))

    def describe(self, account):
        """Why the rule picks the account, in the words of an outcome."""
        if account in self.idle:
            return f'{account}, whose week had not started'
        return f'{account}, whose weekly allowance reset first ({100 - self.weekly[account]}% left)'

    def record_codex_task(self, label, thread, forks=()):
        """The proxy records a fork's responses under the task it was forked from."""
        threads = [thread, *forks]
        self.records.append((label, thread, lambda: [usage for each in threads for usage in rig.codex_client_usage(each)],
                             lambda: [request for each in threads for request in rig.forwarded_requests(thread=each)]))

    def record_pi_session(self, label, session):
        self.records.append((label, rig.pi_task_id(session), lambda: rig.pi_client_usage(session),
                             lambda: rig.forwarded_requests(session=session, client='pi')))


def main():
    if len(sys.argv) == 3 and sys.argv[1] == '--group':
        raise SystemExit(run_group(sys.argv[2]))
    if len(sys.argv) == 3 and sys.argv[1] == '--clean-up':
        # Stops what a group that ended without cleaning up left running; prints it, one item a line.
        print('\n'.join(rig.clean_up()))
        raise SystemExit(0)
    # --only GROUP,GROUP runs those groups, for working on one.
    only = set(sys.argv[2].split(',')) if len(sys.argv) == 3 and sys.argv[1] == '--only' else None
    began = time.monotonic()
    signal.signal(signal.SIGTERM, stop)
    if rig.ROOT.exists():
        previous = rig.ROOT.with_name(f'system-test.previous.{time.time_ns()}')
        os.rename(rig.ROOT, previous)
        subprocess.Popen(['trash', str(previous)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    rig.ROOT.mkdir(parents=True)
    try:
        rig.build()
    except Failure as failure:
        print(f'The system did not start: {failure}')
        raise SystemExit(1)
    print(f'Built in {format_duration(time.monotonic() - began)}. Codex: {rig.CODEX}. Claude Code: {rig.CLAUDE}. '
          + (f'Pi: {rig.PI}.' if rig.PI else 'Pi is not on PATH, so Pi is not tested.'), flush=True)
    groups = {name: subprocess.Popen([sys.executable, __file__, '--group', name], env=dict(os.environ, CODEX_SWITCH_SYSTEM_TEST_RUN=str(rig.ROOT / name)),
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
              for name, _, _ in GROUPS if only is None or name in only}
    try:
        for process in groups.values():
            process.wait()
    except KeyboardInterrupt:
        for process in groups.values():
            os.killpg(process.pid, signal.SIGTERM)
        for process in groups.values():
            process.wait()
        print('\nStopped before the end.')
    results, leftovers = [], []
    for name, process in groups.items():
        path = rig.ROOT / name / 'results.jsonl'
        reported = [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []
        expected = len(next(outcomes for group, _, outcomes in GROUPS if group == name)) + 1
        outcomes_reported = [result for result in reported if 'leftovers' not in result]
        if not any('leftovers' in result for result in reported):
            cleanup = subprocess.run([sys.executable, __file__, '--clean-up', name], capture_output=True, text=True,
                                     env=dict(os.environ, CODEX_SWITCH_SYSTEM_TEST_RUN=str(rig.ROOT / name)))
            leftovers += [line for line in cleanup.stdout.splitlines() if line]
        # A group that stopped early, or never cleaned up, has not shown its outcomes held.
        if process.returncode or len(outcomes_reported) != expected or not any('leftovers' in result for result in reported):
            reported.append({'outcome': f'The {name} group finished', 'held': False, 'seconds': 0,
                             'observed': f'It exited with {process.returncode} after reporting {len(outcomes_reported)} of {expected} outcomes'
                                         f'{"" if any("leftovers" in result for result in reported) else " and no cleanup"}. '
                                         f'See {(rig.ROOT / name / "system-test.out").relative_to(rig.REPO)}.'})
        for result in reported:
            if 'leftovers' in result:
                leftovers += result['leftovers']
                continue
            results.append(result['held'])
            print(('PASS  ' if result['held'] else 'FAIL  ') + f'[{name}] {result["outcome"]} ({format_duration(result["seconds"])})')
            for line in result['observed'].splitlines():
                print('      ' + line)
    print('Nothing is left running.' if not leftovers else 'STILL RUNNING: ' + '; '.join(leftovers))
    passed = sum(results)
    print(f'{passed} of {len(results)} outcomes held, in {format_duration(time.monotonic() - began)}. Evidence: {rig.ROOT.relative_to(rig.REPO)}')
    raise SystemExit(0 if results and passed == len(results) and not leftovers else 1)


def run_group(name):
    """Runs one group of outcomes on its own isolated system and writes what each did to results.jsonl."""
    signal.signal(signal.SIGTERM, stop)
    first_proxy, outcomes = next((first, outcomes) for group, first, outcomes in GROUPS if group == name)
    rig.RUN.mkdir(parents=True)
    log = (rig.RUN / 'system-test.out').open('w')
    sys.stdout = sys.stderr = log
    results = (rig.RUN / 'results.jsonl').open('w')
    leftovers = []
    try:
        system = System(rig.prepare(first_proxy))
        if name == "resets":
            system.extra = ["claude-grant"]
        system.apply()  # before the proxy's first allowance read
        rig.start_fake_providers()
        system.base = rig.start_proxy()
        for outcome in [*outcomes, every_response_recorded_once]:
            results.write(json.dumps(run_outcome(outcome, system)) + '\n')
            results.flush()
    except Failure as failure:
        results.write(json.dumps({'outcome': 'The system did not start', 'held': False, 'seconds': 0, 'observed': str(failure)}) + '\n')
    except KeyboardInterrupt:
        pass
    finally:
        leftovers = rig.clean_up()
    results.write(json.dumps({'leftovers': leftovers}) + '\n')
    return 0


def stop(signal_number, frame):
    raise KeyboardInterrupt  # so cleanup runs when the run is terminated


def run_outcome(outcome, system):
    began = time.monotonic()
    try:
        observed, held = outcome(system), True
    except Failure as failure:
        observed, held = str(failure), False
    except Exception as error:  # a defect in this test, reported without stopping the run
        observed, held = f'The test itself failed: {error!r}', False
    if not held:
        system.extra = []  # a response left held would hang every later outcome
        system.apply()
    return {'outcome': outcome.__doc__.strip(), 'held': held, 'observed': observed, 'seconds': time.monotonic() - began}


def start_installer(candidate, name):
    environment = dict(os.environ, HOME=str(rig.RUN / 'home'), CODEX_SWITCH_LAUNCHD_LABEL=rig.LABEL,
                       CODEX_SWITCH_LISTEN=rig.listen_address(), CODEX_SWITCH_PROVING_SECONDS=str(PROVING_SECONDS),
                       CODEX_SWITCH_SWITCH_LIMIT_SECONDS=str(SWITCH_LIMIT_SECONDS))
    return rig.start_client([str(rig.REPO / 'deploy/install-proxy.sh'), str(rig.RUN / candidate)], name, env=environment)


def wait_for_candidate(old):
    return rig.wait_for(lambda: (status['pid'] if (status := rig.deploy_status()) and status['pid'] != old else None),
                        'the candidate to take new connections', timeout=60)


def update_waits_for_work(system):
    """An update waits until model work arrives"""
    old = rig.deploy_status()['pid']
    update = start_installer('candidate', 'no-work-update')
    time.sleep(2)
    if update.poll() is not None or not rig.deploy_status() or rig.deploy_status()['pid'] != old:
        raise Failure('The installer exited or switched before any model reply completed.')
    rig.stop_process_group(update)
    if rig.deploy_status()['pid'] != old:
        raise Failure('Stopping the waiting installer changed the serving proxy.')
    return 'The installer waited with the original proxy serving until real model work was available.'


def t3_reads_the_account_pool(system):
    """T3 can read each account's allowance and credits but cannot redeem or relay arbitrary requests"""
    capability = rig.read('data/client-capability').strip()
    base = f'http://{rig.listen_address()}/v0/management/'

    def request(path, payload=None, key=capability):
        body = None if payload is None else json.dumps(payload).encode()
        headers = {'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json'}
        with urllib.request.urlopen(urllib.request.Request(base + path, body, headers), timeout=5) as response:
            return json.load(response)

    files = request('auth-files')['files']
    if len(files) != 6 or {f['provider'] for f in files} != {'codex', 'claude'}:
        raise Failure(f'Expected six Codex and Claude accounts, got {files!r}')
    def call(account, url, method='GET'):
        return request('api-call', {'auth_index': account, 'method': method, 'url': url, 'header': {'Authorization': 'Bearer $TOKEN$'}})
    # A stopped provider cannot answer: these calls must use the monitor's readings.
    provider = rig.started_processes[0]
    os.kill(provider.pid, signal.SIGSTOP)
    try:
        codex = call('account-1', 'https://chatgpt.com/backend-api/wham/usage')
        credits = call('account-1', 'https://chatgpt.com/backend-api/wham/rate-limit-reset-credits')
        claude = call('account-4', 'https://api.anthropic.com/api/oauth/usage')
    finally:
        os.kill(provider.pid, signal.SIGCONT)
    if codex['status_code'] != 200 or not json.loads(codex['body'])['rate_limit']:
        raise Failure('Codex allowance was not returned.')
    if credits['status_code'] != 200 or len(json.loads(credits['body'])['credits']) != 1:
        raise Failure('Reset credits were not returned.')
    if claude['status_code'] != 200 or not json.loads(claude['body'])['five_hour']:
        raise Failure('Claude allowance was not returned.')
    for url, method in [('https://chatgpt.com/backend-api/wham/rate-limit-reset-credits/consume', 'POST'), ('https://example.com/', 'GET')]:
        if call('account-1', url, method)['status_code'] != 403:
            raise Failure('The proxy accepted a forbidden call.')
    try:
        request('auth-files', key='wrong')
        raise Failure('The proxy accepted the wrong management key.')
    except urllib.error.HTTPError as error:
        if error.code != 401:
            raise
    return 'Six accounts, allowances and a reset credit were visible with the provider paused; redemption, arbitrary calls and a wrong key were rejected.'


def new_work_goes_to_the_allowance_that_resets_first(system):
    """New work goes to an account whose week has not started, then to the allowance that resets first, and avoids soft reserves; pinned work and its forks stay until the account reaches its hard reserve"""
    leader = system.best_account()
    leader_reason = system.describe(leader)
    task = rig.CodexTask('routing-task', 'Follow this script.\nRUN: ' + SUM.format(result='routing.txt') + '\nREPLY: 16').finish()
    tasks = {'Codex task': task.thread}
    if rig.PI:
        session = str(uuid.uuid4())
        rig.run_pi('routing-pi-first', 'Reply with the word one.', session)
        tasks['Pi session'] = rig.pi_task_id(session)
    started = {name: rig.pinned_account(task_id) for name, task_id in tasks.items()}
    if set(started.values()) != {leader}:
        raise Failure(f'The rule picks {leader_reason}, but '
                      + ' and '.join(f'the {name} went to {account}' for name, account in started.items()) + '.')

    # The runner-up's allowance resets and nothing uses it, so its week has not started.
    runner_up = system.best_account(excluding={leader})
    system.idle.add(runner_up)
    system.weekly[runner_up] = 0
    system.apply()
    # Two reads at the new level: the proxy has applied at least the first.
    rig.wait_for(lambda: rig.usage_reads(runner_up, 0) >= 2, 'the proxy to read the idle week')
    rig.CodexTask('routing-task-again', 'Follow this script.\nRUN: cat routing.txt\nREPLY: 16', thread=task.thread).finish()
    if rig.PI:
        rig.run_pi('routing-pi-second', 'Reply with the word two.', session)
        system.record_pi_session('routing Pi session', session)
    new_task = rig.CodexTask('routing-new-task', 'Reply with the word fresh.').finish()

    # The Codex app forks a task after its turns, sending the task's conversation under a new thread ID.
    fork = rig.fork_codex_task('routing-fork', task.thread, 'Reply with the word forked.')
    fork_accounts = {account for account, _ in rig.forwarded_requests(thread=fork)}
    if fork_accounts != {leader}:
        raise Failure(f'A fork of the Codex task pinned to {leader} was served by {sorted(fork_accounts)}, while new work went to {runner_up}.')

    system.record_codex_task('routing Codex task', task.thread, forks=[fork])
    system.record_codex_task('second routing Codex task', new_task.thread)
    served = {name: {row[0] for row in rig.database_rows(task_id)} for name, task_id in tasks.items()}
    if any(accounts != {leader} for accounts in served.values()) or rig.pinned_account(new_task.thread) != runner_up:
        raise Failure(f'After {runner_up}\'s week went idle, '
                      + ', '.join(f'the {name} was served by {sorted(accounts)}' for name, accounts in served.items())
                      + f', and a new task went to {rig.pinned_account(new_task.thread)}.')

    replacement = system.best_account(excluding={runner_up})
    reserve = 100 - system.weekly[runner_up]
    account_name = next(name for name, key in rig.account_keys_by_name().items() if key == runner_up)
    rig.proxy_command('reserve', account_name, str(reserve), '0')
    try:
        previous_requests = len(rig.forwarded_requests(thread=new_task.thread))
        continued = rig.CodexTask('soft-reserve-pinned-task', 'Reply with the word continued.', thread=new_task.thread).finish()
        fresh = rig.CodexTask('soft-reserve-new-task', 'Reply with the word fresh.').finish()
        system.record_codex_task('new task with an account at its soft reserve', fresh.thread)
        next_requests = rig.forwarded_requests(thread=new_task.thread)[previous_requests:]
        if not next_requests or {account for account, _ in next_requests} != {runner_up}:
            raise Failure(f'At {runner_up}\'s soft reserve, the pinned task\'s next requests went to {next_requests}, '
                          f'not {runner_up}.')
        fresh_requests = rig.forwarded_requests(thread=fresh.thread)
        if not fresh_requests or {account for account, _ in fresh_requests} != {replacement}:
            raise Failure(f'At {runner_up}\'s soft reserve, new work went to {fresh_requests}, not {replacement}.')
        if rig.pinned_account(new_task.thread) != runner_up or rig.pinned_account(fresh.thread) != replacement:
            raise Failure(f'At {runner_up}\'s soft reserve, the continued task is pinned to '
                          f'{rig.pinned_account(new_task.thread)} and new work to {rig.pinned_account(fresh.thread)}.')
        require_no_replay('New work avoided the soft reserve', fresh_requests)
        if continued.errors or fresh.errors:
            raise Failure(f'Codex showed {describe_errors(continued.errors + fresh.errors)} at the soft reserve.')

        previous_requests = len(rig.forwarded_requests(thread=new_task.thread))
        rig.proxy_command('reserve', runner_up, str(reserve), str(reserve))
        continued = rig.CodexTask('hard-reserve-pinned-task', 'Reply with the word continued.', thread=new_task.thread).finish()
        fresh = rig.CodexTask('hard-reserve-new-task', 'Reply with the word fresh.').finish()
        system.record_codex_task('new task with an account at its hard reserve', fresh.thread)
        next_requests = rig.forwarded_requests(thread=new_task.thread)[previous_requests:]
        if not next_requests or {account for account, _ in next_requests} != {replacement}:
            raise Failure(f'With {reserve}% reserved on {runner_up}, the pinned task\'s next requests went to {next_requests}, '
                          f'not {replacement}.')
        fresh_requests = rig.forwarded_requests(thread=fresh.thread)
        if not fresh_requests or {account for account, _ in fresh_requests} != {replacement}:
            raise Failure(f'With {runner_up} held in reserve, new work went to {fresh_requests}, not {replacement}.')
        if rig.pinned_account(new_task.thread) != replacement or rig.pinned_account(fresh.thread) != replacement:
            raise Failure(f'With {runner_up} held in reserve, the continued task is pinned to '
                          f'{rig.pinned_account(new_task.thread)} and new work to {rig.pinned_account(fresh.thread)}, '
                          f'not {replacement}.')
        require_no_replay('The task moved for its reserve', rig.forwarded_requests(thread=new_task.thread))
        require_no_replay('New work avoided the hard reserve', fresh_requests)
        if continued.errors or fresh.errors:
            raise Failure(f'Codex showed {describe_errors(continued.errors + fresh.errors)} while an account was held in reserve.')
    finally:
        rig.proxy_command('reserve', runner_up, 'off')
    return (f'A {" and a ".join(tasks)} started on {leader_reason}.\n'
            f'Then {runner_up}\'s week had not started. Each took its second turn on {leader} again, and a new Codex task went to {runner_up}.\n'
            f'A fork of the Codex task, made through the Codex app-server, was served by {leader} too.\n'
            f'At {account_name}\'s {reserve}% soft reserve, its pinned task stayed and new work went to {replacement}.\n'
            f'Setting its hard reserve to {reserve}% moved the pinned task on its next turn; new work still went to {replacement}.\n'
            'The proxy picked up the command without restart; no model request was replayed and Codex showed no error.')


def request_without_task_id_is_served(system):
    """A request without a task ID is served"""
    best = system.best_account()
    status, completed = rig.post_without_task_id(system.base, 'Reply with the word four.')
    rows = rig.database_rows('')
    if status != 200 or len(completed) != 1 or not rows:
        raise Failure(f'The proxy answered {status} with {len(completed)} completed responses and recorded {len(rows)}.')
    if rig.pinned_account(''):
        raise Failure('The request was served, but the proxy pinned the empty task ID to an account.')
    if rows[-1][0] != best:
        raise Failure(f'The request was served by {rows[-1][0]}, but the rule picks {system.describe(best)}.')
    record_taskless_usage(system, completed)
    return f'A streamed request with no task ID got a complete answer from {system.describe(best)}. No task was pinned.'


def record_taskless_usage(system, completed):
    usage = completed[0]['usage']
    system.taskless_usage.append((usage['input_tokens'], usage['input_tokens_details']['cached_tokens'], usage['output_tokens'],
                                  usage['output_tokens_details']['reasoning_tokens']))


def claude_works_through_the_https_proxy(system):
    """Claude Code gets a reply through the HTTPS proxy, on a Claude account, recorded once with its tokens"""
    require_available_claude_accounts(1)
    session = str(uuid.uuid4())
    result = rig.run_claude(session)
    reply, task = result.get('result', '').strip(), 'claude:code:' + session
    if result.get('is_error') or not reply:
        raise Failure(f'Claude Code did not return a reply: {result.get("result")!r}.')
    placement = [line for line in rig.proxy_log().splitlines() if task in line and 'new task assigned to Claude ' in line]
    account = rig.pinned_account(task)
    if len(placement) != 1 or account not in rig.CLAUDE_ACCOUNTS:
        raise Failure(f'Claude Code replied, but its task has {len(placement)} Claude placement lines and is pinned to {account}.')
    received = claude_tokens(result)
    rows = rig.database_rows(task)
    if rows != [(account, *received)] or received[0] <= 0 or received[2] <= 0:
        raise Failure(f'Claude Code received tokens {received}; the proxy recorded {rows}.')
    system.records.append(('Claude Code task', task, lambda: [received], None))
    return (f'Claude Code replied {reply!r} through HTTPS_PROXY and NODE_EXTRA_CA_CERTS, using Haiku at low effort against\n'
            'api.anthropic.com. Its task was placed on a Claude account and its response was recorded once,\n'
            f'with {received[0]} input tokens ({received[1]} cached) and {received[2]} output tokens.')


def claude_throttle_holds_the_account_briefly(system):
    """When Anthropic throttles a Claude request without naming a usage limit, the account serves the task again once the throttle ends"""
    throttled = require_available_claude_accounts(1)[0]
    others = [account for account in rig.CLAUDE_ACCOUNTS if account != throttled]
    session, throttled_before = str(uuid.uuid4()), len(rig.fake_provider_events('claude-throttled'))
    # A full reserve holds every other account back, so only the throttled account can serve.
    for account in others:
        rig.proxy_command('reserve', account, '100', '100')
    try:
        with simulating(system, 'claude-throttle 1'):
            began = time.monotonic()
            result = rig.run_claude(session, must_succeed=False)
            took = time.monotonic() - began
    finally:
        for account in others:
            rig.proxy_command('reserve', account, 'off')
    reply, task = result.get('result', '').strip(), 'claude:code:' + session
    if len(rig.fake_provider_events('claude-throttled')) != throttled_before + 1:
        raise Failure('The fake providers did not throttle exactly one Claude request.')
    if result.get('is_error') or not reply or rig.pinned_account(task) != throttled:
        raise Failure(f'After one throttled request on {throttled}, Claude Code said {reply!r} after {format_duration(took)}; '
                      f'the task is pinned to {rig.pinned_account(task)}.')
    throttled_at = rig.fake_provider_event_times('claude-throttled', account=throttled)[-1]
    served_at = [at for at in rig.fake_provider_event_times('claude-forwarded', account=throttled) if at > throttled_at]
    # The throttle's Retry-After is one second; the fake's clock and log are the evidence. The account is held for
    # that second and no longer.
    if not served_at or not 0.95 <= served_at[0] - throttled_at <= 4:
        raise Failure(f'{throttled} was asked again {served_at[0] - throttled_at:.2f} seconds after its throttle; its Retry-After was one second.'
                      if served_at else f'{throttled} was never asked again after its throttle.')
    received = claude_tokens(result)
    system.records.append(('Claude Code task after a throttle', task, lambda: [received], None))
    held = [line.split(': ', 1)[1] for line in rig.proxy_log().splitlines() if 'without naming a usage limit' in line][-1:]
    return (f'With every other Claude account held back, Anthropic answered {throttled}\'s first request with a 429 naming no limit,\n'
            f'a one-second Retry-After and a reset seven hours away. The proxy said: {held[0] if held else "(nothing)"}\n'
            f'{throttled} was asked again {served_at[0] - throttled_at:.1f} seconds later and replied {reply!r}.')


def claude_fast_mode_refusal_stays_on_the_account(system):
    """When Anthropic refuses fast mode for want of usage credits, Claude Code carries on at standard speed on the same account; a usage limit on a fast-mode request still moves the task"""
    require_available_claude_accounts(2)
    session, refused_before = str(uuid.uuid4()), len(rig.fake_provider_events('claude-fast-mode-refused'))
    first = rig.run_claude(session, must_succeed=False, fast_mode=True)
    task = 'claude:code:' + session
    started_on = rig.pinned_account(task)
    refused = len(rig.fake_provider_events('claude-fast-mode-refused')) - refused_before
    moves = [line for line in rig.proxy_log().splitlines() if task in line and ': moved from ' in line]
    received = [claude_tokens(first)] if not first.get('is_error') else []
    system.records.append(('Claude Code task in fast mode', task, lambda: received, None))
    if not refused:
        raise Failure('Claude Code did not ask for fast mode, so the refusal was not tested.')
    if first.get('is_error') or moves:
        raise Failure(f'After {refused} fast-mode refusals Claude Code said {first.get("result")!r}; the task moved {len(moves)} times.')
    limited_before = len(rig.fake_provider_events('claude-rejected-usage-limit'))
    with simulating(system, f'claude-limited {started_on}'):
        second = rig.run_claude(session, must_succeed=False, resume=True, fast_mode=True)
    if not second.get('is_error'):
        received.append(claude_tokens(second))
    moved_to = rig.pinned_account(task)
    if second.get('is_error') or moved_to == started_on or len(rig.fake_provider_events('claude-rejected-usage-limit')) == limited_before:
        raise Failure(f'With {started_on} at its five-hour limit, a fast-mode prompt left the task on {moved_to}; Claude Code said {second.get("result")!r}.')
    return (f'Claude Code asked for Opus in fast mode; Anthropic\'s refusal for want of usage credits reached it {refused} time(s) unchanged.\n'
            f'It carried on at standard speed on {started_on}, the account it started on, and replied {first["result"].strip()!r}.\n'
            f'When {started_on} then reached its five-hour limit, the next fast-mode prompt moved to {moved_to}, which replied {second["result"].strip()!r}.')


def claude_limit_moves_the_task_to_a_free_account(system):
    """When a Claude task's account reaches its usage limit, the task's next prompt is answered by another account, and Claude Code shows no limit"""
    require_available_claude_accounts(2)
    session = str(uuid.uuid4())
    first = rig.run_claude(session)
    task = 'claude:code:' + session
    limited = rig.pinned_account(task)
    rejected_before = len(rig.fake_provider_events('claude-rejected-usage-limit'))
    with simulating(system, f'claude-limited {limited}'):
        began = time.monotonic()
        second = rig.run_claude(session, must_succeed=False, resume=True)
        took = time.monotonic() - began
    reply, moved_to = second.get('result', '').strip(), rig.pinned_account(task)
    received = [claude_tokens(first)] + ([claude_tokens(second)] if not second.get('is_error') else [])
    system.records.append(('Claude Code task that moved account', task, lambda: received, None))
    if second.get('is_error') or not reply:
        raise Failure(f'With {limited} at its limit, Claude Code said {reply!r} after {format_duration(took)}.')
    if moved_to == limited or len(rig.fake_provider_events('claude-rejected-usage-limit')) != rejected_before + 1:
        raise Failure(f'The task is pinned to {moved_to}; Anthropic refused '
                      f'{len(rig.fake_provider_events("claude-rejected-usage-limit")) - rejected_before} of its requests.')
    return (f'A Claude task started on {limited}, which then reached its five-hour limit. Anthropic refused the next prompt\n'
            f'once; the proxy gave Claude Code a retry instead of the limit, and {moved_to} replied {reply!r} after {format_duration(took)}.')


def claude_limit_reaches_the_client_at_once(system):
    """With every Claude account at its usage limit, Claude Code stops at once and says when the limit resets, and so does the next task"""
    require_available_claude_accounts(1)
    runs = []
    with simulating(system, *[f'claude-limited {account}' for account in rig.CLAUDE_ACCOUNTS]):
        for _ in ('first task', 'next task'):
            session, rejected_before = str(uuid.uuid4()), len(rig.fake_provider_events('claude-rejected-usage-limit'))
            began = time.monotonic()
            result = rig.run_claude(session, must_succeed=False)
            runs.append((session, time.monotonic() - began, result.get('result', '').strip(), result.get('is_error'),
                         len(rig.fake_provider_events('claude-rejected-usage-limit')) - rejected_before))
    for label, (session, took, said, is_error, _) in zip(('The first task', 'The next task'), runs):
        if not is_error or took > 30 or 'limit' not in said.lower():
            raise Failure(f'{label}: Claude Code took {format_duration(took)} and said {said!r}; it should stop at once and name the limit.')
    session, took, said, _, sent = runs[1]
    told = [line.split(' refused after ', 1)[1] for line in rig.proxy_log().splitlines() if 'claude:code:' + session in line and ' refused after ' in line]
    if sent or not told:
        raise Failure(f'The next task sent {sent} requests to Anthropic; the proxy knew every account was limited and should answer itself.')
    return (f'With every Claude account at its five-hour limit, Claude Code stopped after {format_duration(runs[0][1])}: {runs[0][2]!r}\n'
            f'The proxy answered the next task itself, sending nothing to Anthropic ({told[0]}).\n'
            f'Claude Code stopped after {format_duration(took)}: {said!r}')


def require_available_claude_accounts(count):
    """The fake Claude accounts, every one with allowance left."""
    if not rig.CLAUDE:
        raise Failure('Claude Code is not installed.')
    return list(rig.CLAUDE_ACCOUNTS[:max(count, len(rig.CLAUDE_ACCOUNTS))])


def claude_tokens(result):
    """(input, cached, output, reasoning) as the proxy records them, from Claude Code's own result."""
    usage = result['usage']
    return (usage['input_tokens'] + usage.get('cache_read_input_tokens', 0) + usage.get('cache_creation_input_tokens', 0),
            usage.get('cache_read_input_tokens', 0), usage['output_tokens'], 0)


@contextlib.contextmanager
def simulating(system, *lines):
    system.extra = list(lines)
    system.apply()
    try:
        yield
    finally:
        system.extra = []
        system.apply()


def exhausted_task_moves_on_its_next_turn(system):
    """When a task's account runs out, its next turn moves to another account: no replayed work, no repeated tool effect, no error shown"""
    start = system.best_account()
    expected = system.best_account(excluding={start})
    system.extra = [f'exhaust-after {start} 1']
    system.apply()
    goal = rig.Goal('exhaustion-goal', GOAL)
    errors = goal.finish()
    system.limited.add(start)
    system.extra = []
    system.apply()
    system.record_codex_task('goal that moved account', goal.thread)

    forwarded = rig.forwarded_requests(thread=goal.thread)
    accounts = [account for account, _ in forwarded]
    refused = rig.fake_provider_events('websocket-rejected-usage-limit', thread=goal.thread) + rig.fake_provider_events('rejected-usage-limit', thread=goal.thread)
    if not accounts or accounts[0] != start or not refused or sorted(set(accounts) - {start}) != [expected]:
        raise Failure(f'Expected the goal to start on {start} and move to {expected}. Its model requests went to {accounts}; '
                      f'{len(refused)} were refused for the usage limit.')
    require_no_replay('The goal', forwarded)
    if errors:
        raise Failure(f'The goal finished, but Codex showed {describe_errors(errors)}.')
    return (f'A goal started on {start}. Its second model request found {start} out of allowance; the proxy kept the limit from\n'
            f'Codex, and Codex\'s retry went to {system.describe(expected)}. The goal finished by itself.\n'
            f'None of its {len(forwarded)} model requests reached OpenAI twice, its tool effect ran once, and Codex showed no error.')


def websocket_age_limit_does_not_interrupt_work(system):
    """When OpenAI ends a WebSocket at its one-hour limit during a tool call, the goal carries on over a new connection: no replay, no error shown"""
    with simulating(system, 'websocket-age-limit 1.5'):
        goal = rig.Goal('age-limit-goal', SLEEPING_GOAL)
        rig.wait_for(lambda: rig.fake_provider_events('websocket-age-limit', thread=goal.thread), "OpenAI to end the goal's WebSocket at its age limit")
    (rig.RUN / 'work/age-limit-goal-release').touch()
    errors = goal.finish()
    system.record_codex_task('goal across the WebSocket age limit', goal.thread)

    forwarded = rig.forwarded_requests(thread=goal.thread)
    require_no_replay('The goal', forwarded)
    opened = rig.fake_provider_events('websocket-open', thread=goal.thread)
    if len(opened) < 2:
        raise Failure(f'The goal finished on {len(opened)} WebSocket connection(s); the test expected a new one after the age limit.')
    if errors:
        raise Failure(f'The goal finished, but Codex showed {describe_errors(errors)}.')
    logged = [line.split(': ', 1)[1] for line in rig.proxy_log().splitlines() if goal.thread in line and 'one-hour limit' in line]
    if logged != ['OpenAI closed the WebSocket at its one-hour limit with no request in progress; the next request opens a new connection']:
        raise Failure(f'The proxy log described the age limit as {logged}.')
    return (f'A goal\'s tool call was running when OpenAI ended its WebSocket at the age limit. The proxy logged: {logged[0]}.\n'
            f'The goal\'s next request went over a new connection ({len(opened)} opened) and the goal finished by itself.\n'
            f'None of its {len(forwarded)} model requests reached OpenAI twice, its tool effect ran once, and Codex showed no error.')


def goal_continues_when_an_account_returns(system):
    """With every account exhausted, a running goal continues by itself when one comes back"""
    start = system.best_account()
    returning = next(account for account in system.accounts if account != start)
    system.limited = set(system.accounts) - {start}
    system.extra = [f'exhaust-after {start} 1']
    system.apply()
    goal = rig.Goal('outage-goal', GOAL)
    rig.wait_for(lambda: f'limited {start}' in rig.read('control'), f'{start} to run out of allowance')
    time.sleep(1)
    system.limited = set(system.accounts) - {returning}
    system.extra = []
    system.apply()
    returned_at = time.monotonic()
    errors = goal.finish(timeout=60)
    finished_after = time.monotonic() - returned_at
    system.limited = set()
    system.apply()
    system.record_codex_task('goal through the outage', goal.thread)

    forwarded = rig.forwarded_requests(thread=goal.thread)
    accounts = [account for account, _ in forwarded]
    if not accounts or accounts[0] != start or accounts[-1] != returning:
        raise Failure(f'Expected the goal to start on {start} and finish on {returning}; its model requests went to {accounts}.')
    require_no_replay('The goal', forwarded)
    shown = f'While it waited, Codex showed {describe_errors(errors)}.' if errors else 'Codex showed no error.'
    return (f'A goal started on {start}; after one model request every account was out of allowance. A second later\n'
            f'{returning} came back. The goal continued on {returning} without being restarted and finished {finished_after:.0f} seconds\n'
            f'after that. No model request reached OpenAI twice and its tool effect ran once.\n{shown}')


def update_during_work_finishes_on_the_old_process(system):
    """A blue-green update during work completes by itself, and admitted work finishes on the old process"""
    goal = rig.Goal('update-goal', SLEEPING_GOAL)
    rig.wait_for(goal.effect_file.exists, 'the goal to start the tool call that spans the update')
    # Two Codex responses are held mid-stream on the old process: one over WebSocket, one over HTTP.
    system.extra = ['hold-responses codex_exec']
    system.apply()
    websocket_task = rig.CodexTask('update-websocket-task', 'Reply with the word socket.')
    rig.wait_for(lambda: rig.fake_provider_events('response-held', client='codex_exec'), 'a WebSocket response to start', timeout=60)
    system.extra = ['http-only', 'hold-responses codex_exec']
    system.apply()
    http_task = rig.CodexTask('update-http-task', 'Reply with the word stream.')
    rig.wait_for(lambda: len(rig.fake_provider_events('response-held', client='codex_exec')) == 2, 'an HTTP response to start', timeout=60)
    system.extra = ['hold-responses codex_exec']
    system.apply()
    old = rig.deploy_status()['pid']
    held = rig.fake_provider_events('response-held', client='codex_exec')
    held_on_old = {event['remote'] for event in held}
    if sorted(event['method'] for event in held) != ['GET', 'POST'] or not held_on_old <= rig.fake_provider_connections(old):
        raise Failure(f'Expected one WebSocket and one HTTP response held on the serving process {old}; held {held}.')

    # Preserve a recognisable account identity but remove its isolated access
    # token, as happens when that account needs signing in again.
    signed_out = rig.RUN / 'data/account-9999'
    signed_out.mkdir()
    auth = rig.json.loads((rig.RUN / 'data' / system.accounts[0] / 'auth.json').read_text())
    auth['tokens']['access_token'] = ''
    auth['tokens']['account_id'] = 'signed-out-test-account'
    token_parts = auth['tokens']['id_token'].split('.')
    claims = rig.json.loads(rig.base64.urlsafe_b64decode(token_parts[1] + '==='))
    claims.setdefault('https://api.openai.com/auth', {})['chatgpt_user_id'] = 'signed-out-test-user'
    token_parts[1] = rig.base64.urlsafe_b64encode(rig.json.dumps(claims).encode()).decode().rstrip('=')
    auth['tokens']['id_token'] = '.'.join(token_parts)
    (signed_out / 'auth.json').write_text(rig.json.dumps(auth))
    update_started = time.monotonic()
    update = start_installer('candidate', 'update')
    new = wait_for_candidate(old)
    if goal.result_file.exists():
        raise Failure('The goal finished its tool call before the update began, so it did not run across the update.')
    (rig.RUN / 'work/update-goal-release').touch()
    # New work during the drain: held too, so the process holding it can be seen.
    new_task = rig.CodexTask('update-new-task', 'Reply with the word new.')
    rig.wait_for(lambda: len(rig.fake_provider_events('response-held', client='codex_exec')) >= 3, 'new work to start', timeout=60)
    held_on_new = {event['remote'] for event in rig.fake_provider_events('response-held', client='codex_exec')} - held_on_old
    new_work_on_new_process = new != old and held_on_new and held_on_new <= rig.fake_provider_connections(new)
    old_was_draining = held_on_old <= rig.fake_provider_connections(old)
    try:
        # Both versions run for the proof; the old one keeps the replies it holds.
        time.sleep(max(0, PROVING_SECONDS - (time.monotonic() - update_started)))
        if any(task.process.poll() is not None for task in (websocket_task, http_task)) or not rig.process_alive(old):
            raise Failure('An old model reply ended, or the old process went, before the proof finished.')
    finally:
        system.extra = []
        system.apply()
    for task in (websocket_task, http_task, new_task):
        task.finish()
        system.record_codex_task(task.name, task.thread)
    errors = goal.finish() + websocket_task.errors + http_task.errors + new_task.errors
    system.record_codex_task('goal across the update', goal.thread)
    rig.wait_for(lambda: not rig.process_alive(old), 'the old process to retire', timeout=120)
    try:
        exit_code = update.wait(timeout=120)
    except rig.subprocess.TimeoutExpired:
        raise Failure('The installer did not finish cleanup after the old proxy exited.')
    if exit_code:
        raise Failure(f'The update command failed: {rig.read("logs/update.err")[-400:]}')
    signed_out.rename(rig.RUN / 'data/reauth-account')
    final = rig.deploy_status()['pid']

    if not new_work_on_new_process or not old_was_draining:
        raise Failure(f'New work did not start on new process {new} while old process {old} still held its two responses.')
    canceled = rig.fake_provider_events('response-canceled')
    replies = (websocket_task.reply.lower(), http_task.reply.lower(), new_task.reply.lower())
    if canceled or 'socket' not in replies[0] or 'stream' not in replies[1] or 'new' not in replies[2]:
        raise Failure(f'{len(canceled)} held responses were cancelled; Codex replied {replies}; see process {old} in data/proxy.log.')
    if final != new or rig.process_alive(old):
        raise Failure(f'After the update, process {final} serves; expected {new}, with old process {old} gone.')
    loaded = [label for label in (rig.LABEL, rig.LABEL + '.a', rig.LABEL + '.b')
              if rig.subprocess.run(['launchctl', 'print', f'gui/{os.getuid()}/{label}'], capture_output=True).returncode == 0]
    if len(loaded) != 1 or loaded[0] == rig.LABEL:
        raise Failure(f'Expected one new slot after adopting the legacy job, got {loaded}.')
    same_bundle = start_installer('candidate', 'same-bundle')
    if same_bundle.wait(timeout=120) or rig.deploy_status()['pid'] != final:
        raise Failure(f'Reopening the same bundle restarted the proxy or failed: {rig.read("logs/same-bundle.err")[-400:]}')
    for label, thread in (('A held task', websocket_task.thread), ('A held task', http_task.thread), ('The new task', new_task.thread), ('The goal', goal.thread)):
        require_no_replay(label, rig.forwarded_requests(thread=thread))
    if errors:
        raise Failure(f'The update completed, but Codex showed {describe_errors(errors)}.')
    return ('The published release\'s launchd job was adopted while one WebSocket and one HTTP response were mid-stream. New work\n'
            'went to the new slot despite an account needing sign-in; both responses finished on the old process, which then retired.\n'
            'Only the new slot remained loaded.\n'
            'A goal running a tool across the update finished with its effect run once. Nothing was replayed and Codex showed no error.')


def retiring_proxy_keeps_only_working_connections(system):
    """A retiring proxy finishes its replies, closes idle connections, keeps a transferring tunnel, and is gone at the switch limit"""
    warm = rig.CodexTask('retire-warmup', 'Reply with the word ready.').finish()
    system.record_codex_task('retire warmup', warm.thread)
    old = rig.deploy_status()['pid']
    held_before = len(rig.fake_provider_events('response-held', client='codex_exec'))
    canceled_before = len(rig.fake_provider_events('response-canceled'))
    system.extra = ['hold-responses codex_exec']
    system.apply()
    held = rig.CodexTask('retire-held', 'Reply with the word held.')
    rig.wait_for(lambda: len(rig.fake_provider_events('response-held', client='codex_exec')) > held_before, 'a reply to be held', timeout=60)
    tunnels = rig.TunnelPair()
    update = start_installer('candidate-2', 'retire-update')
    try:
        new = wait_for_candidate(old)
        switch_started = int(rig.read('data/switch-started').strip())
        status, completed = rig.post_without_task_id(system.base, 'Reply with the word proof.')
        if status != 200 or len(completed) != 1:
            raise Failure(f'The candidate answered {status} with {len(completed)} completed responses.')
        record_taskless_usage(system, completed)
        rig.wait_for(lambda: f'process {old} stopping' in rig.proxy_log(), 'the old proxy to begin retiring', timeout=60)
        retirement_began = time.monotonic()
        if held.process.poll() is not None:
            raise Failure('The held reply ended before retirement began.')
    finally:
        system.extra = []
        system.apply()
    try:
        held.finish()
        system.record_codex_task('reply held across retirement', held.thread)
        if 'held' not in held.reply.lower() or held.errors or len(rig.fake_provider_events('response-canceled')) != canceled_before:
            raise Failure(f'The held reply was cut: Codex replied {held.reply!r} and showed {describe_errors(held.errors)}.')
        rig.wait_for(tunnels.idle_http_closed, 'the idle HTTP connection to close', timeout=30)
        rig.wait_for(tunnels.idle_closed, 'the silent tunnel to close', timeout=90)
        silent_for = time.monotonic() - retirement_began
        if silent_for < rig.CONNECTION_DRAIN_SECONDS * 0.8:
            raise Failure(f'The silent tunnel closed {silent_for:.0f} seconds into retirement, before its {rig.CONNECTION_DRAIN_SECONDS}-second grace.')
        while rig.process_alive(old):
            if tunnels.error:
                raise Failure(f'The transferring tunnel was cut {time.time() - switch_started:.0f} seconds after the switch began: {tunnels.error}')
            if time.time() - switch_started > SWITCH_LIMIT_SECONDS + 3:
                raise Failure(f'The old proxy did not retire within the {SWITCH_LIMIT_SECONDS}-second limit.')
            time.sleep(0.1)
        completed_after = time.time() - switch_started
    finally:
        tunnels.close()
    if completed_after < SWITCH_LIMIT_SECONDS - 2:
        raise Failure(f'The old proxy retired {completed_after:.0f} seconds after the switch began, with a tunnel still transferring.')
    if update.wait(timeout=120):
        raise Failure(f'The update command failed: {rig.read("logs/retire-update.err")[-400:]}')
    if rig.deploy_status()['pid'] != new:
        raise Failure(f'After retirement process {rig.deploy_status()["pid"]} serves, not {new}.')
    return (f'A held reply finished on the old process. The idle HTTP connection closed at once and the silent tunnel {silent_for:.0f} seconds into\n'
            f'retirement. The transferring tunnel kept moving data until the limit, and the old process was gone {completed_after:.0f} seconds after the switch began.')


def provider_outage_blocks_neither_restart_nor_release(system):
    """During a provider outage a crashed proxy restarts, and a release starts on failed work and waits instead of being skipped"""
    old = rig.deploy_status()['pid']
    build = rig.subprocess.check_output([str(rig.RUN / 'candidate-3'), 'print-build'], text=True).strip()
    system.extra = ['usage-error', 'provider-error']
    system.apply()
    try:
        os.kill(old, signal.SIGKILL)
        restarted = rig.wait_for(lambda: (status['pid'] if (status := rig.deploy_status()) and status['pid'] != old else None),
                                 'launchd to restart the proxy during the outage', timeout=60)
        update = start_installer('candidate-3', 'outage-update')
        time.sleep(2)
        if update.poll() is not None or rig.deploy_status()['pid'] != restarted:
            raise Failure('The installer did not wait for work during the outage.')
        try:
            rig.post_without_task_id(system.base, 'Provider outage test.')
        except rig.urllib.error.HTTPError as error:
            if error.code != 503:
                raise Failure(f'The simulated provider error returned HTTP {error.code}, expected 503.')
        else:
            raise Failure('The simulated provider error did not reach the client.')
        try:
            exit_code = update.wait(timeout=60)
        except rig.subprocess.TimeoutExpired:
            raise Failure('A failed request did not start the waiting update.')
    finally:
        system.extra = []
        system.apply()
    skipped = rig.read('data/skipped-builds').splitlines() if (rig.RUN / 'data/skipped-builds').exists() else []
    if not exit_code or build in skipped:
        raise Failure(f'The installer exited with {exit_code} and skipped builds are {skipped}; the release should be tried again.')
    if rig.deploy_status()['pid'] != restarted:
        raise Failure('The serving proxy changed although the candidate could not read the accounts.')
    return ('With every usage read failing, launchd restarted a killed proxy. One failed request started the waiting update; the candidate\n'
            f'could not read the accounts and stopped, and build {build} was not skipped, so the installer tries it again.')


def failed_release_steps_aside(system):
    """A release that breaks real requests steps aside and is recorded as skipped"""
    warm = rig.CodexTask('failure-warmup', 'Reply with the word ready.').finish()
    system.record_codex_task('failure warmup', warm.thread)
    old = rig.deploy_status()['pid']
    build = rig.subprocess.check_output([str(rig.RUN / 'candidate-3'), 'print-build'], text=True).strip()
    install = start_installer('candidate-3', 'bad-update')
    new = wait_for_candidate(old)
    system.extra = ['provider-error']
    system.apply()
    for number in range(3):
        try:
            rig.post_without_task_id(system.base, f'Provider error test {number}.')
        except rig.urllib.error.HTTPError as error:
            if error.code != 503:
                raise Failure(f'The simulated provider error returned HTTP {error.code}, expected 503.')
        else:
            raise Failure('The simulated provider error did not reach the client.')
    if len(rig.fake_provider_events('provider-error')) < 3 or rig.deploy_status()['failures'] != 0:
        raise Failure('Provider errors were counted against the candidate.')

    held_before = len(rig.fake_provider_events('response-held', client='codex_exec'))
    system.extra = ['hold-responses codex_exec']
    system.apply()
    canceled = rig.CodexTask('cancel-during-proof', 'Reply with the word canceled.')
    rig.wait_for(lambda: len(rig.fake_provider_events('response-held', client='codex_exec')) > held_before,
                 'a candidate response to begin before canceling', timeout=60)
    rig.stop_process_group(canceled.process)
    system.extra = []
    system.apply()
    rig.wait_for(lambda: rig.fake_provider_events('response-canceled', client='codex_exec'),
                 'the canceled response to close', timeout=30)
    if rig.deploy_status()['pid'] != new or rig.deploy_status()['failures'] != 0:
        raise Failure('A client cancellation counted against the candidate.')

    system.extra = ['break-responses']
    system.apply()
    began = time.monotonic()
    tasks = [rig.CodexTask(f'failure-task-{number}', f'Reply with the number {number}.') for number in range(3)]
    try:
        rig.wait_for(lambda: rig.deploy_status() and rig.deploy_status()['pid'] == old,
                     'the old slot to resume serving after malformed responses', timeout=60)
    finally:
        system.extra = []
        system.apply()
    elapsed = time.monotonic() - began
    if install.wait(timeout=60):
        raise Failure(f'Failed release did not exit successfully: {rig.read("logs/bad-update.err")[-400:]}')
    for task in tasks:
        task.finish()
        system.record_codex_task(task.name, task.thread)
        require_no_replay(task.name, rig.forwarded_requests(thread=task.thread))
    skipped = (rig.RUN / 'data/skipped-builds').read_text().splitlines()
    status = rig.proxy_command('status')
    if build not in skipped or build not in status:
        raise Failure(f'Skipped build {build} is not recorded and shown in status: {status[-500:]}')
    if len(rig.fake_provider_events('malformed-response')) < 2:
        raise Failure('The fake providers did not deliver two malformed responses to the candidate.')
    return f'Build {build} stopped taking traffic after malformed responses in {elapsed:.1f} seconds; process {old} resumed, status named the skipped build, and all three Codex tasks finished.'


def queued_releases_install_newest(system):
    """Queued releases converge on the newest without overlapping switches"""
    warm = rig.CodexTask('queue-warmup', 'Reply with the word ready.').finish()
    system.record_codex_task('queue warmup', warm.thread)
    original = rig.deploy_status()['pid']
    first = start_installer('candidate-4', 'queue-first')
    wait_for_candidate(original)
    middle = start_installer('candidate-5', 'queue-middle')
    newest = start_installer('candidate-6', 'queue-newest')
    observed, process_counts = [], []
    monitoring = threading.Event()
    def observe():
        while not monitoring.wait(0.5):
            status = rig.deploy_status()
            if status:
                observed.append(int(status['build']))
            process_counts.append(len(rig.run_processes(only_servers=True)))
    observer = threading.Thread(target=observe, daemon=True)
    observer.start()
    traffic = rig.CodexTask('queue-traffic', 'Reply with the word flowing.').finish()
    system.record_codex_task('traffic during queued update', traffic.thread)
    if first.wait(timeout=60):
        raise Failure(f'First queued update failed: {rig.read("logs/queue-first.err")[-400:]}')
    expected = int(rig.subprocess.check_output([str(rig.RUN / 'candidate-6'), 'print-build'], text=True).strip())
    def newest_serving():
        # The newest installer switches on model work and proves the build on a reply of its own, so keep work coming.
        if (status := rig.deploy_status()) and int(status['build']) == expected:
            return True
        try:
            status_code, completed = rig.post_without_task_id(system.base, 'Reply with the word queued.')
        except rig.urllib.error.HTTPError:
            return False  # a proxy that is retiring may refuse it
        if status_code == 200 and completed:
            record_taskless_usage(system, completed)
        return False
    rig.wait_for(newest_serving, 'the newest build to take new connections', timeout=60, interval=0.5)
    newest_traffic = rig.CodexTask('queue-newest-traffic', 'Reply with the word newest.').finish()
    system.record_codex_task('traffic on the newest queued build', newest_traffic.thread)
    deadline = time.monotonic() + 600
    while time.monotonic() < deadline and (middle.poll() is None or newest.poll() is None):
        time.sleep(1)
    monitoring.set()
    observer.join(timeout=10)
    if process_counts and max(process_counts) > 2:
        raise Failure(f'As many as {max(process_counts)} proxy processes ran during queued updates.')
    if middle.poll() is None or newest.poll() is None or middle.returncode or newest.returncode:
        raise Failure(f'Queued installers did not finish successfully: {rig.read("logs/queue-middle.err")[-300:]} {rig.read("logs/queue-newest.err")[-300:]}')
    final = rig.deploy_status()
    if int(final['build']) != expected or observed != sorted(observed):
        raise Failure(f'Queued builds served {observed}; final build {final["build"]}, expected {expected}.')
    return f'The newest build {expected} serves after the queued installers finished; builds never went backwards and at most two proxy processes ran.'


def every_response_recorded_once(system):
    """Each completed response is recorded once, with its account, task and tokens"""
    problems, total = [], 0
    for label, task, client_usage, forwarded_requests in system.records:
        rows = rig.database_rows(task)
        total += len(rows)
        recorded, received = [row[1:] for row in rows], client_usage()
        if recorded != received:
            problems.append(f'{label}: the client received {len(received)} responses and the proxy recorded {len(recorded)}. '
                            f'Tokens (input, cached, output, reasoning): client {received}, proxy {recorded}.')
        if forwarded_requests:
            recorded_accounts, forwarded_accounts = [row[0] for row in rows], [account for account, _ in forwarded_requests()]
            if recorded_accounts != forwarded_accounts:
                problems.append(f'{label}: recorded on {recorded_accounts}, sent to OpenAI on {forwarded_accounts}.')
    unexplained = rig.database_row_count() - total
    if unexplained:
        problems.append(f'The proxy recorded {unexplained} responses that belong to no task this test ran.')
    if problems:
        raise Failure('\n'.join(problems))
    return (f'{total} responses across {len(system.records)} tasks, sessions and requests. Each was recorded once, in order, on the\n'
            f'account its request was sent on, under its task, with the input, cached, output and reasoning tokens the client received.')


def require_no_replay(label, forwarded):
    fingerprints = [fingerprint for _, fingerprint in forwarded]
    if len(set(fingerprints)) != len(fingerprints):
        raise Failure(f'{label} sent {len(fingerprints) - len(set(fingerprints))} model requests to OpenAI a second time.')


def describe_errors(errors):
    """Codex's own words for each error it showed, from app-server notifications or `codex exec` events."""
    shown = []
    for error in errors:
        detail = error.get('params', {}).get('error') or error.get('error') or error
        message = detail.get('message', '') if isinstance(detail, dict) else str(detail)
        cause = detail.get('additionalDetails') or '' if isinstance(detail, dict) else ''
        shown.append(f'"{message}" ({cause.split(", url:")[0]})' if cause else f'"{message}"')
    return ', '.join(shown)


def format_duration(seconds):
    minutes, seconds = divmod(round(seconds), 60)
    return f'{minutes}m {seconds:02d}s'


def stored_resets(system):
    """An agent spends a reset only when the pool is exhausted, choosing the first expiry and safely retrying a lost response"""
    env = dict(os.environ, **rig.proxy_environment())
    def command(*args):
        return subprocess.run([str(rig.RUN / 'cli'), *args], env=env, capture_output=True, text=True, timeout=15)
    status = command('status')
    if status.returncode or 'reset credits: 2' not in status.stdout:
        raise Failure(f'Claude grants missing from status: {status.stdout} {status.stderr}')
    (rig.RUN / 'reset-status.txt').write_text(status.stdout)
    claude = command('reset', 'claude')
    if claude.returncode or 'not supported yet' not in claude.stdout:
        raise Failure(f'Claude reset: {claude.stdout} {claude.stderr}')
    system.extra = ['reset-test']
    system.apply()
    available = command('reset', 'codex')
    if available.returncode or 'can continue working' not in available.stdout:
        raise Failure(f'Available pool: {available.stdout} {available.stderr}')
    system.limited = set(system.accounts)
    system.extra = ['reset-test', 'reset-soon']
    system.apply()
    soon = command('reset', 'codex')
    if soon.returncode or 'within 30 minutes' not in soon.stdout:
        raise Failure(f'Near reset: {soon.stdout} {soon.stderr}')
    if 'event=reset-claim' in rig.read('logs/fake-providers.log'):
        raise Failure('A credit was spent while an account was available or returning soon.')
    system.extra = ['reset-test', 'reset-refuse']
    system.apply()
    refused = command('reset', 'codex')
    if refused.returncode == 0 or 'outcome unknown' not in refused.stderr:
        raise Failure(f'Refused redemption: {refused.stdout} {refused.stderr}')
    system.limited = set(system.accounts) - {'account-1'}
    system.extra = ['reset-test']
    system.apply()
    recovered = command('reset', 'codex')
    if recovered.returncode or 'can continue working' not in recovered.stdout:
        raise Failure(f'Retry after capacity returned: {recovered.stdout} {recovered.stderr}')
    if 'event=reset-claim' in rig.read('logs/fake-providers.log'):
        raise Failure('A retry spent a credit after another account could work again.')
    system.limited = set(system.accounts)
    system.extra = ['reset-test', 'reset-drop']
    system.apply()
    reads_before_reset = rig.usage_reads('account-2', system.weekly['account-2'])
    lost = command('reset', 'codex')
    if lost.returncode == 0 or 'outcome unknown' not in lost.stderr:
        raise Failure(f'Lost response: {lost.stdout} {lost.stderr}')
    retry = command('reset', 'codex')
    if retry.returncode or 'already redeemed' not in retry.stdout:
        raise Failure(f'Retry: {retry.stdout} {retry.stderr}')
    claims = re.findall(r'event=reset-claim account=(\S+) credit=(\S+) request=(\S+)', rig.read('logs/fake-providers.log'))
    if len(claims) != 2 or claims[0] != claims[1] or claims[0][:2] != ('account-2', 'credit-account-2'):
        raise Failure(f'Expected two identical claims for the earliest credit; got {claims}')
    rig.wait_for(lambda: rig.usage_reads('account-2', system.weekly['account-2']) > reads_before_reset, 'the proxy to observe the reset account')
    task = rig.CodexTask('reset-resumed-work', 'Reply with the word resumed.').finish()
    system.record_codex_task('work after reset', task.thread)
    if rig.pinned_account(task.thread) != 'account-2':
        raise Failure(f'Work after the reset used {rig.pinned_account(task.thread)}, not the reset account.')
    return 'Status showed 2 Claude resets; available and near-reset pools spent none. A refused redemption spent nothing once another account could work. The exhausted pool chose the earliest credit, retried its lost response with the same request ID, and resumed work on that account.'


